<!-- PRODUCT LISTINGS: Immediate Showcase Directly Below Navbar -->
<div class="py-5 sm:py-7 bg-[#FAF6EE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <% if @category.present? || params[:q].present? %>
      <div class="mb-5 flex items-center justify-between text-xs text-neutral-600 bg-white px-4 py-2.5 rounded-xl border border-[#EFE7DA]">
        <div>
          Showing:
          <% if @category.present? %>
            <strong class="text-[#140B07]"><%= @category.name %></strong>
            <span class="text-[#D48B38] font-amharic ml-1">(<%= @category.amharic_name %>)</span>
          <% end %>
          <% if params[:q].present? %>
            matching <span class="italic text-[#140B07]">"<%= params[:q] %>"</span>
          <% end %>
          <span class="text-neutral-400 ml-1.5">• <%= @products.count %> items</span>
        </div>
        <%= link_to "✕ Show All", root_path, class: "text-xs font-semibold text-[#9E472A] hover:underline" %>
      </div>
    <% end %>

    <!-- Product Grid: Immediate Visual Showcase -->
    <% if @products.empty? %>
      <div class="py-12 bg-white rounded-xl border border-[#EFE7DA] text-center space-y-3">
        <h3 class="font-serif text-lg font-bold text-[#140B07]">No Products Found</h3>
        <p class="text-xs text-neutral-500">No offerings match your current selection.</p>
        <div>
          <%= link_to "View All Products", root_path, class: "px-4 py-2 rounded-lg bg-[#24130D] text-[#E5A652] text-xs font-semibold inline-block hover:bg-[#140B07]" %>
        </div>
      </div>
    <% else %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5">
        <% @products.each do |product| %>
          <div class="bg-white rounded-xl border border-[#EFE7DA] overflow-hidden shadow-xs hover:shadow-md transition-all flex flex-col justify-between group">
            
            <div>
              <!-- Product Image Thumbnail (Single Specific Image Only) -->
              <div class="w-full h-52 sm:h-56 overflow-hidden bg-[#FAF6EE] border-b border-[#EFE7DA] relative">
                <%= link_to product_path(product), class: "block w-full h-full" do %>
                  <img src="<%= product.display_image_url %>" alt="<%= product.name %>" class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300" loading="lazy">
                <% end %>
              </div>

              <!-- Details Section: Clean & Non-Repetitive -->
              <div class="p-3.5 space-y-1.5">
                <div class="text-[11px] text-[#D48B38] font-amharic font-semibold"><%= product.amharic_name %></div>
                <h3 class="font-serif text-sm font-bold text-[#140B07] group-hover:text-[#9E472A] transition-colors leading-snug">
                  <%= link_to product.name, product_path(product) %>
                </h3>

                <% if product.coffee? && product.tasting_notes.present? %>
                  <p class="text-[11px] text-[#9E472A] font-medium leading-relaxed">
                    <%= product.tasting_notes %>
                  </p>
                <% else %>
                  <p class="text-xs text-neutral-500 line-clamp-2 leading-relaxed">
                    <%= product.short_description.presence || product.description %>
                  </p>
                <% end %>
              </div>
            </div>

            <!-- Price & Direct Cart Actions -->
            <div class="p-3 border-t border-[#EFE7DA] bg-[#FAF6EE]/30 flex items-center justify-between gap-2">
              <span class="font-bold text-sm text-[#140B07]">
                <%= product.formatted_price(current_currency) %>
              </span>

              <%= form_with url: cart_add_path, method: :post, local: false, class: "flex items-center space-x-1" do |f| %>
                <%= f.hidden_field :product_id, value: product.id %>
                <%= f.hidden_field :quantity, value: 1 %>
                <%= f.hidden_field :format_selected, value: (product.coffee? ? "Roasted Whole Beans" : "Standard") %>
                <%= f.submit "Add", class: "py-1 px-2.5 rounded-lg bg-[#24130D] hover:bg-[#140B07] text-[#E5A652] text-xs font-semibold cursor-pointer shadow-xs transition-colors" %>
                <button type="submit" name="buy_now" value="true" class="py-1 px-2.5 rounded-lg bg-[#00A859] hover:bg-[#008F4C] text-white text-xs font-semibold cursor-pointer shadow-xs transition-colors">
                  Buy Now
                </button>
              <% end %>
            </div>

          </div>
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<div class="py-12 bg-[#FAF6EE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Title & Breadcrumbs -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#EFE7DA] pb-6">
      <div>
        <span class="text-xs font-bold text-[#9E472A] uppercase tracking-widest">Store Catalog</span>
        <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[#140B07]">
          <%= @category ? @category.name : "All Buna Offerings" %>
          <% if @category %><span class="text-lg font-amharic text-[#D48B38] ml-2 font-normal">(<%= @category.amharic_name %>)</span><% end %>
        </h1>
        <p class="text-xs text-neutral-600 mt-1">Single-origin coffees, handcrafted Jebenas, and cultural ceremony artifacts.</p>
      </div>

      <!-- Search Form -->
      <%= form_with url: products_path, method: :get, local: true, class: "flex items-center space-x-2" do |f| %>
        <%= f.text_field :q, value: params[:q], placeholder: "Search Yirgacheffe, Jebena, Sini...", class: "px-4 py-2 text-xs rounded-xl border border-[#EFE7DA] bg-white focus:outline-none focus:ring-2 focus:ring-[#D48B38] w-64" %>
        <%= f.submit "Search", class: "px-4 py-2 bg-[#24130D] text-[#E5A652] rounded-xl text-xs font-semibold hover:bg-[#140B07] transition-all cursor-pointer" %>
      <% end %>
    </div>

    <!-- Category Tabs -->
    <div class="flex items-center space-x-2 overflow-x-auto pb-2 scrollbar-none">
      <%= link_to "All Categories", products_path, class: "px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all #{params[:category].blank? ? 'bg-[#24130D] text-[#E5A652]' : 'bg-white text-neutral-700 hover:bg-[#EFE7DA]'}" %>
      <% @categories.each do |cat| %>
        <%= link_to products_path(category: cat.slug), class: "px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all #{params[:category] == cat.slug ? 'bg-[#24130D] text-[#E5A652]' : 'bg-white text-neutral-700 hover:bg-[#EFE7DA]'}" do %>
          <span><%= cat.name %></span>
          <span class="text-[10px] text-neutral-400 font-amharic ml-1">(<%= cat.amharic_name %>)</span>
        <% end %>
      <% end %>
    </div>

    <!-- Secondary Filters (Origin Zone & Roast Profile) -->
    <div class="bg-white p-4 rounded-2xl border border-[#EFE7DA] flex flex-wrap items-center justify-between gap-4 text-xs">
      <!-- Zone Filter -->
      <div class="flex items-center space-x-2 flex-wrap gap-1">
        <span class="text-neutral-500 font-medium">Origin Zone:</span>
        <% %w[Sidamo Yirgacheffe Harrar Limu Kaffa].each do |zone| %>
          <%= link_to zone, products_path(category: params[:category], zone: (params[:zone] == zone ? nil : zone)), class: "px-2.5 py-1 rounded-lg text-xs font-medium #{params[:zone] == zone ? 'bg-[#D48B38] text-white' : 'bg-[#FAF6EE] text-[#3A2016] hover:bg-[#EFE7DA]'}" %>
        <% end %>
      </div>

      <!-- Roast Filter -->
      <div class="flex items-center space-x-2 flex-wrap gap-1">
        <span class="text-neutral-500 font-medium">Roast:</span>
        <% ["Light", "Medium", "Traditional Dark Roast"].each do |roast| %>
          <%= link_to roast, products_path(category: params[:category], roast: (params[:roast] == roast ? nil : roast)), class: "px-2.5 py-1 rounded-lg text-xs font-medium #{params[:roast] == roast ? 'bg-[#24130D] text-[#E5A652]' : 'bg-[#FAF6EE] text-[#3A2016] hover:bg-[#EFE7DA]'}" %>
        <% end %>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% @products.each do |product| %>
        <div class="bg-white rounded-2xl border border-[#EFE7DA] overflow-hidden shadow-sm hover:shadow-lg transition-all duration-200 flex flex-col justify-between group">
          
          <div>
            <!-- Card Banner -->
            <div class="p-5 bg-gradient-to-br from-[#FAF6EE] to-[#EFE7DA]/60 border-b border-[#EFE7DA] flex items-center justify-between">
              <span class="px-2.5 py-0.5 rounded-full bg-white text-[#9E472A] text-[10px] font-bold border border-[#EFE7DA]">
                <%= product.category.name %>
              </span>
              <% if product.roast_profile.present? %>
                <span class="px-2 py-0.5 rounded bg-[#24130D] text-[#E5A652] text-[10px] font-semibold">
                  <%= product.roast_profile %>
                </span>
              <% end %>
            </div>

            <!-- Content -->
            <div class="p-5 space-y-3">
              <div>
                <span class="text-[11px] text-[#D48B38] font-amharic font-semibold"><%= product.amharic_name %></span>
                <h3 class="font-serif text-base font-bold text-[#140B07] group-hover:text-[#9E472A] transition-colors">
                  <%= link_to product.name, product_path(product) %>
                </h3>
                <p class="text-xs text-neutral-600 mt-1 line-clamp-2 leading-relaxed">
                  <%= product.short_description.presence || product.description %>
                </p>
              </div>

              <!-- Coffee Metadata Chips -->
              <% if product.coffee? %>
                <div class="text-[10px] text-neutral-500 space-y-1 bg-[#FAF6EE] p-2.5 rounded-xl border border-[#EFE7DA]">
                  <% if product.elevation.present? %>
                    <div><strong>Elevation:</strong> <%= product.elevation %></div>
                  <% end %>
                  <% if product.processing_method.present? %>
                    <div><strong>Process:</strong> <%= product.processing_method %></div>
                  <% end %>
                  <% if product.tasting_notes.present? %>
                    <div class="text-[#9E472A]"><strong>Notes:</strong> <%= product.tasting_notes %></div>
                  <% end %>
                </div>
              <% elsif product.material.present? %>
                <div class="text-[10px] text-neutral-600 bg-[#FAF6EE] p-2.5 rounded-xl border border-[#EFE7DA]">
                  <strong>Material:</strong> <%= product.material %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Footer Price & Add to Cart -->
          <div class="p-5 border-t border-[#EFE7DA] bg-[#FAF6EE]/30">
            <div class="flex items-center justify-between mb-3">
              <div>
                <span class="text-[10px] text-neutral-500 block">Price (<%= current_currency %>)</span>
                <span class="font-bold text-base text-[#140B07]"><%= product.formatted_price(current_currency) %></span>
              </div>
              <span class="text-[10px] text-[#00A859] font-semibold">● In Stock</span>
            </div>

            <!-- Add to Cart Form with Format Selector -->
            <%= form_with url: cart_add_path, method: :post, local: false, class: "space-y-2" do |f| %>
              <%= f.hidden_field :product_id, value: product.id %>
              <%= f.hidden_field :quantity, value: 1 %>

              <% if product.coffee? %>
                <div class="flex items-center space-x-1">
                  <%= f.select :format_selected, [["Whole Beans", "Roasted Whole Beans"], ["Fine Ground (Jebena)", "Ground"], ["Green Beans", "Raw Green Beans"]], {}, class: "w-full text-[11px] py-1.5 px-2 rounded-lg border border-[#EFE7DA] bg-white text-neutral-700 focus:outline-none" %>
                </div>
              <% end %>

              <%= f.submit "Add to Basket", class: "w-full py-2 px-3 rounded-lg bg-[#24130D] hover:bg-[#00A859] text-[#E5A652] hover:text-white text-xs font-semibold transition-all cursor-pointer shadow-sm" %>
            <% end %>
          </div>

        </div>
      <% end %>
    </div>

  </div>
</div>

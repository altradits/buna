<div class="py-12 bg-[#FAF6EE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center space-x-2 text-xs text-neutral-500">
      <%= link_to "Home", root_path, class: "hover:text-[#9E472A]" %>
      <span>/</span>
      <%= link_to "Products", products_path, class: "hover:text-[#9E472A]" %>
      <span>/</span>
      <%= link_to @product.category.name, products_path(category: @product.category.slug), class: "hover:text-[#9E472A]" %>
      <span>/</span>
      <span class="text-[#140B07] font-semibold"><%= @product.name %></span>
    </nav>

    <!-- Main Product Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Visual Display -->
      <div class="lg:col-span-6 bg-white p-6 sm:p-10 rounded-2xl border border-[#EFE7DA] shadow-xs flex flex-col items-center justify-center text-center">
        <div class="w-40 h-40 sm:w-52 sm:h-52 rounded-xl bg-gradient-to-br from-[#FAF6EE] to-[#EFE7DA]/50 border border-[#EFE7DA] flex items-center justify-center p-4 shadow-inner">
          <% if @product.coffee? %>
            <div class="space-y-1.5">
              <div class="font-serif font-bold text-lg text-[#24130D]"><%= @product.origin_zone %></div>
              <div class="text-xs text-[#9E472A] font-amharic font-semibold"><%= @product.amharic_name %></div>
            </div>
          <% else %>
            <div class="space-y-1.5">
              <div class="font-serif font-bold text-lg text-[#24130D]"><%= @product.name %></div>
              <div class="text-xs text-[#9E472A] font-amharic font-semibold"><%= @product.amharic_name %></div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Purchase & Specification Details -->
      <div class="lg:col-span-6 space-y-5">
        <div>
          <div class="flex items-center space-x-2">
            <span class="px-2 py-0.5 rounded-full bg-[#EFE7DA] text-[#9E472A] text-[11px] font-bold">
              <%= @product.category.name %>
            </span>
            <span class="text-[11px] text-neutral-400">SKU: <%= @product.sku %></span>
          </div>

          <h1 class="font-serif text-2xl sm:text-3xl font-bold text-[#140B07] mt-1.5"><%= @product.name %></h1>
          <div class="text-sm text-[#D48B38] font-amharic font-semibold mt-0.5"><%= @product.amharic_name %></div>
        </div>

        <!-- Clean Pricing -->
        <div class="p-3.5 rounded-xl bg-white border border-[#EFE7DA] flex items-center justify-between">
          <div>
            <span class="text-[10px] text-neutral-400 block uppercase font-medium">Price</span>
            <span class="font-serif text-2xl font-bold text-[#140B07]"><%= @product.formatted_price(current_currency) %></span>
          </div>
          <span class="text-xs text-[#00A859] font-semibold">In Stock</span>
        </div>

        <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
          <%= @product.description %>
        </p>

        <!-- Technical Taxonomy Grid -->
        <% if @product.coffee? %>
          <div class="grid grid-cols-2 gap-2.5 p-3.5 rounded-xl bg-white border border-[#EFE7DA] text-xs">
            <% if @product.origin_zone.present? %>
              <div><span class="text-neutral-400 text-[10px] uppercase block">Origin</span> <span class="font-semibold text-[#140B07]"><%= @product.origin_zone %></span></div>
            <% end %>
            <% if @product.roast_profile.present? %>
              <div><span class="text-neutral-400 text-[10px] uppercase block">Roast</span> <span class="font-semibold text-[#140B07]"><%= @product.roast_profile %></span></div>
            <% end %>
            <% if @product.processing_method.present? %>
              <div><span class="text-neutral-400 text-[10px] uppercase block">Process</span> <span class="font-semibold text-[#140B07]"><%= @product.processing_method %></span></div>
            <% end %>
            <% if @product.elevation.present? %>
              <div><span class="text-neutral-400 text-[10px] uppercase block">Elevation</span> <span class="font-semibold text-[#140B07]"><%= @product.elevation %></span></div>
            <% end %>
            <% if @product.tasting_notes.present? %>
              <div class="col-span-2"><span class="text-neutral-400 text-[10px] uppercase block">Tasting Notes</span> <span class="font-medium text-[#9E472A]"><%= @product.tasting_notes %></span></div>
            <% end %>
          </div>
        <% elsif @product.material.present? %>
          <div class="p-3.5 rounded-xl bg-white border border-[#EFE7DA] text-xs space-y-1.5">
            <div><span class="text-neutral-400 text-[10px] uppercase block">Material</span> <span class="font-semibold text-[#140B07]"><%= @product.material %></span></div>
            <% if @product.dimensions.present? %>
              <div><span class="text-neutral-400 text-[10px] uppercase block">Dimensions</span> <span class="font-semibold text-[#140B07]"><%= @product.dimensions %></span></div>
            <% end %>
            <% if @product.cultural_significance.present? %>
              <div><span class="text-neutral-400 text-[10px] uppercase block">Ceremony Significance</span> <p class="text-neutral-600 text-xs mt-0.5"><%= @product.cultural_significance %></p></div>
            <% end %>
          </div>
        <% end %>

        <!-- Add to Cart Form -->
        <%= form_with url: cart_add_path, method: :post, local: false, class: "space-y-3 pt-1" do |f| %>
          <%= f.hidden_field :product_id, value: @product.id %>

          <div class="grid grid-cols-2 gap-3">
            <% if @product.coffee? %>
              <div>
                <label class="block text-xs font-semibold text-neutral-700 mb-1">Format</label>
                <%= f.select :format_selected, [["Roasted Whole Beans", "Roasted Whole Beans"], ["Fine Ground (Jebena)", "Ground"], ["Raw Green Beans", "Raw Green Beans"]], {}, class: "w-full text-xs p-2.5 rounded-xl border border-[#EFE7DA] bg-white text-neutral-800 focus:ring-2 focus:ring-[#D48B38]" %>
              </div>
            <% else %>
              <div>
                <label class="block text-xs font-semibold text-neutral-700 mb-1">Spec</label>
                <input type="text" readonly value="Handcrafted" class="w-full text-xs p-2.5 rounded-xl border border-[#EFE7DA] bg-[#FAF6EE] text-neutral-600">
              </div>
            <% end %>

            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-1">Quantity</label>
              <%= f.number_field :quantity, value: 1, min: 1, max: 20, class: "w-full text-xs p-2.5 rounded-xl border border-[#EFE7DA] bg-white text-neutral-800 focus:ring-2 focus:ring-[#D48B38]" %>
            </div>
          </div>

          <div class="flex items-center gap-3 pt-1">
            <%= f.submit "Add to Basket", class: "flex-1 py-3 px-4 rounded-xl bg-[#24130D] hover:bg-[#140B07] text-[#E5A652] font-bold text-xs shadow transition-all cursor-pointer text-center" %>
            
            <button type="submit" name="buy_now" value="true" class="flex-1 py-3 px-4 rounded-xl bg-[#00A859] hover:bg-[#008F4C] text-white font-bold text-xs shadow transition-all text-center whitespace-nowrap cursor-pointer">
              Buy Now
            </button>
          </div>
        <% end %>

      </div>

    </div>

    <!-- Related Products -->
    <% if @related_products.any? %>
      <div class="pt-12 border-t border-[#EFE7DA] space-y-6">
        <h3 class="font-serif text-2xl font-bold text-[#140B07]">Complementary Ceremony Artifacts</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <% @related_products.each do |rel| %>
            <div class="bg-white p-5 rounded-2xl border border-[#EFE7DA] flex flex-col justify-between">
              <div>
                <div class="text-[10px] text-[#9E472A] font-bold uppercase"><%= rel.category.name %></div>
                <h4 class="font-serif font-bold text-sm text-[#140B07] mt-1"><%= link_to rel.name, product_path(rel), class: "hover:text-[#9E472A]" %></h4>
              </div>
              <div class="pt-3 mt-3 border-t border-[#EFE7DA] flex items-center justify-between">
                <span class="font-bold text-sm text-[#140B07]"><%= rel.formatted_price(current_currency) %></span>
                <%= link_to "View", product_path(rel), class: "text-xs font-semibold text-[#D48B38] hover:underline" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>

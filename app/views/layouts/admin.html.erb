<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900 text-slate-100">
<head>
  <title>Admin Dashboard | Yebente Buna (የበንቴ ቡና)</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-full flex flex-col bg-slate-950 text-slate-100">
  <header class="bg-slate-900 border-b border-slate-800 px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center space-x-2.5">
      <div class="w-7 h-7 rounded-md bg-amber-600 text-slate-950 font-bold text-xs flex items-center justify-center">YB</div>
      <div>
        <h1 class="font-bold text-white text-sm tracking-tight leading-tight">Yebente Buna Operations</h1>
        <p class="text-[10px] text-slate-400 font-mono">+254707172370 • yebente@gmail.com</p>
      </div>
    </div>
    <div class="flex items-center space-x-3 text-xs">
      <%= link_to "Storefront", root_path, class: "text-amber-400 hover:text-amber-300 font-medium" %>
      <span class="text-slate-700">|</span>
      <%= link_to "Dashboard", admin_root_path, class: "text-slate-300 hover:text-white" %>
      <%= link_to "Orders", admin_orders_path, class: "text-slate-300 hover:text-white" %>
      <%= link_to "Logistics", admin_shipments_path, class: "text-slate-300 hover:text-white" %>
    </div>
  </header>

  <main class="flex-grow p-4 sm:p-6 max-w-7xl mx-auto w-full">
    <% if notice.present? %>
      <div class="p-2.5 mb-4 bg-emerald-900/60 border border-emerald-700 text-emerald-200 text-xs rounded-lg"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="p-2.5 mb-4 bg-rose-900/60 border border-rose-700 text-rose-200 text-xs rounded-lg"><%= alert %></div>
    <% end %>
    <%= yield %>
  </main>
</body>
</html>

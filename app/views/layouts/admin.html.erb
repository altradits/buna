<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900 text-slate-100">
<head>
  <title>Admin Dashboard | Yebente Buna (የበንቴ ቡና)</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-full flex flex-col bg-slate-950 text-slate-100">
  <header class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <div class="w-9 h-9 rounded bg-amber-600 text-slate-950 font-bold flex items-center justify-center">YB</div>
      <div>
        <h1 class="font-bold text-white text-base">Yebente Buna Operations Console</h1>
        <p class="text-xs text-slate-400">Merchant: +254707172370 | Admin: yebente@gmail.com</p>
      </div>
    </div>
    <div class="flex items-center space-x-4 text-xs">
      <%= link_to "Storefront", root_path, class: "text-amber-400 hover:underline" %>
      <%= link_to "Orders", admin_orders_path, class: "text-slate-300 hover:text-white" %>
      <%= link_to "Cross-Border Logistics", admin_shipments_path, class: "text-slate-300 hover:text-white" %>
    </div>
  </header>

  <main class="flex-grow p-6 max-w-7xl mx-auto w-full">
    <% if notice.present? %>
      <div class="p-3 mb-6 bg-emerald-900/60 border border-emerald-700 text-emerald-200 text-xs rounded"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="p-3 mb-6 bg-rose-900/60 border border-rose-700 text-rose-200 text-xs rounded"><%= alert %></div>
    <% end %>
    <%= yield %>
  </main>
</body>
</html>

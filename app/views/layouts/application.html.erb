<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <title><%= ENV.fetch("APP_NAME", "Yebente Buna") %> | Premium Authentic Ethiopian Coffee & Cultural Ceremony in Kenya</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Direct from Ethiopian highlands to Kenya: Authentic single-origin coffee (Yirgacheffe, Sidamo, Harrar, Limu, Kaffa), traditional clay Jebena pots, Sini cups, and ceremony incense. Pay seamlessly with Safaricom M-Pesa.">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Google Fonts: Inter & Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Tailwind CSS via CDN / Asset Pipeline -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            buna: {
              dark: '#140B07',
              espresso: '#24130D',
              roast: '#3A2016',
              terracotta: '#9E472A',
              clay: '#B55A3C',
              amber: '#D48B38',
              gold: '#E5A652',
              sand: '#EFE7DA',
              parchment: '#FAF6EE',
              card: '#FDFBF7',
              forest: '#183822'
            },
            safaricom: {
              green: '#00A859',
              hover: '#008F4C',
              dark: '#006C38'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            serif: ['Playfair Display', 'Georgia', 'serif'],
            amharic: ['Nyala', 'Abyssinica SIL', 'Noto Sans Ethiopic', 'sans-serif']
          }
        }
      }
    }
  </script>

  <%= stylesheet_link_tag "application.tailwind", "data-turbo-track": "reload" rescue nil %>
  <%= javascript_importmap_tags rescue nil %>

  <style>
    body { background-color: #FAF6EE; color: #140B07; }
    .font-serif { font-family: 'Playfair Display', Georgia, serif; }
    .pulse-stk { animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
    @keyframes pulse-ring {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: .7; transform: scale(1.03); }
    }
  </style>
</head>

<body class="min-h-full flex flex-col font-sans bg-[#FAF6EE] text-[#140B07]" data-controller="cart">
  
  <!-- Top Utility Bar: Regional Contacts, Currency Switcher, Merchant Line -->
  <div class="bg-[#24130D] text-[#EFE7DA] text-xs py-2 px-4 border-b border-[#3A2016]">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center space-x-4">
        <span class="inline-flex items-center text-[#E5A652] font-medium">
          <svg class="w-3.5 h-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20"><path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/></svg>
          Direct Cross-Border Corridor: Addis Ababa ➔ Moyale ➔ Nairobi
        </span>
        <span class="hidden md:inline text-neutral-400">|</span>
        <span class="hidden md:inline">Merchant Support: <strong class="text-white">+254707172370</strong></span>
      </div>

      <div class="flex items-center space-x-4">
        <!-- Multi-Currency Switcher KES / ETB -->
        <div class="flex items-center bg-[#140B07] rounded-md p-0.5 border border-[#3A2016]" data-controller="currency">
          <%= button_to switch_currency_path(currency: "KES"), method: :post, class: "px-2 py-0.5 text-xs font-semibold rounded #{current_currency == 'KES' ? 'bg-[#D48B38] text-white' : 'text-neutral-300 hover:text-white'}" do %>
            🇰🇪 KES (KSh)
          <% end %>
          <%= button_to switch_currency_path(currency: "ETB"), method: :post, class: "px-2 py-0.5 text-xs font-semibold rounded #{current_currency == 'ETB' ? 'bg-[#D48B38] text-white' : 'text-neutral-300 hover:text-white'}" do %>
            🇪🇹 ETB (ብር)
          <% end %>
        </div>

        <!-- M-Pesa Verified Badge -->
        <div class="inline-flex items-center text-[#00A859] font-medium">
          <span class="w-2 h-2 rounded-full bg-[#00A859] mr-1.5 animate-pulse"></span>
          M-Pesa Express Active
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation Header -->
  <header class="bg-[#FAF6EE]/95 backdrop-blur-md sticky top-0 z-40 border-b border-[#EFE7DA] shadow-sm" data-controller="mobile-menu">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Logo & Amharic Insignia -->
      <%= link_to root_path, class: "flex items-center space-x-3 group" do %>
        <div class="w-12 h-12 rounded-xl bg-[#24130D] text-[#E5A652] flex items-center justify-center shadow-md group-hover:bg-[#140B07] transition-all">
          <span class="font-serif text-2xl font-bold tracking-tight">YB</span>
        </div>
        <div class="flex flex-col">
          <div class="flex items-baseline space-x-2">
            <span class="font-serif text-xl sm:text-2xl font-bold text-[#140B07] tracking-tight group-hover:text-[#9E472A] transition-colors">Yebente Buna</span>
            <span class="text-xs sm:text-sm font-semibold text-[#D48B38] tracking-widest font-amharic">የበንቴ ቡና</span>
          </div>
          <span class="text-[10px] sm:text-[11px] font-medium text-[#9E472A] tracking-wider uppercase">Authentic Ethiopian Ceremony in Kenya</span>
        </div>
      <% end %>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-8 font-medium text-sm text-[#3A2016]">
        <%= link_to "Coffee Varieties", products_path(category: "coffee-varieties"), class: "hover:text-[#9E472A] transition-colors" %>
        <%= link_to "Brewing Hardware (Jebena)", products_path(category: "traditional-brewing-hardware"), class: "hover:text-[#9E472A] transition-colors" %>
        <%= link_to "Serving Ware (Sini & Rekebot)", products_path(category: "serving-ware"), class: "hover:text-[#9E472A] transition-colors" %>
        <%= link_to "Sensory & Incense", products_path(category: "sensory-mood-enhancers"), class: "hover:text-[#9E472A] transition-colors" %>
        <%= link_to "Ceremony Guide", ceremony_guide_path, class: "text-[#9E472A] font-semibold hover:underline" %>
      </nav>

      <!-- Cart Drawer Trigger & Hotline & Mobile Hamburger -->
      <div class="flex items-center space-x-3">
        <a href="tel:+254707172370" class="hidden sm:inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-full bg-[#EFE7DA] text-[#24130D] hover:bg-[#D48B38] hover:text-white transition-all">
          <svg class="w-3.5 h-3.5 mr-1.5 text-[#9E472A]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          +254 707 172370
        </a>

        <!-- Basket Trigger Button -->
        <button type="button" data-action="click->cart#open" aria-label="Open basket" class="relative p-2.5 rounded-xl bg-[#24130D] text-[#E5A652] hover:bg-[#140B07] transition-all shadow-sm cursor-pointer">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span id="cart-counter-badge" class="absolute -top-1.5 -right-1.5 w-5 h-5 rounded-full bg-[#00A859] text-white text-[11px] font-bold flex items-center justify-center shadow">
            <%= cart_count %>
          </span>
        </button>

        <!-- Mobile Menu Toggle Button (lg:hidden) -->
        <button type="button" data-action="click->mobile-menu#toggle" aria-label="Toggle mobile menu" class="lg:hidden p-2.5 rounded-xl bg-white border border-[#EFE7DA] text-[#24130D] hover:bg-[#FAF6EE] transition-colors cursor-pointer">
          <svg data-mobile-menu-target="openIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg data-mobile-menu-target="closeIcon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer Dropdown -->
    <div data-mobile-menu-target="menu" class="hidden lg:hidden border-t border-[#EFE7DA] bg-[#FAF6EE] px-4 py-6 space-y-4 shadow-xl">
      <div class="space-y-1">
        <span class="text-[10px] font-bold uppercase tracking-wider text-[#9E472A] px-3">Buna Catalog Categories</span>
        <%= link_to products_path(category: "coffee-varieties"), data: { action: "click->mobile-menu#close" }, class: "flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold text-[#140B07] hover:bg-white hover:text-[#9E472A] transition-all" do %>
          <span>Single-Origin Coffee Varieties</span>
          <span class="text-xs text-[#D48B38] font-amharic">የቡና ዝርያዎች</span>
        <% end %>
        <%= link_to products_path(category: "traditional-brewing-hardware"), data: { action: "click->mobile-menu#close" }, class: "flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold text-[#140B07] hover:bg-white hover:text-[#9E472A] transition-all" do %>
          <span>Clay Jebenas & Roasting Pans</span>
          <span class="text-xs text-[#D48B38] font-amharic">ጀበና እና መንከሽከሽ</span>
        <% end %>
        <%= link_to products_path(category: "serving-ware"), data: { action: "click->mobile-menu#close" }, class: "flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold text-[#140B07] hover:bg-white hover:text-[#9E472A] transition-all" do %>
          <span>Sini Ceramic Sets & Rekebots</span>
          <span class="text-xs text-[#D48B38] font-amharic">ሲኒ እና ረከቦት</span>
        <% end %>
        <%= link_to products_path(category: "modern-traditional-milling"), data: { action: "click->mobile-menu#close" }, class: "flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold text-[#140B07] hover:bg-white hover:text-[#9E472A] transition-all" do %>
          <span>Milling & Precision Grinders</span>
          <span class="text-xs text-[#D48B38] font-amharic">መፍጫዎች</span>
        <% end %>
        <%= link_to products_path(category: "sensory-mood-enhancers"), data: { action: "click->mobile-menu#close" }, class: "flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold text-[#140B07] hover:bg-white hover:text-[#9E472A] transition-all" do %>
          <span>Frankincense & Tenadam Herbs</span>
          <span class="text-xs text-[#D48B38] font-amharic">ዕጣን እና ጤናዳም</span>
        <% end %>
        <%= link_to products_path(category: "spatial-aesthetics-decor"), data: { action: "click->mobile-menu#close" }, class: "flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold text-[#140B07] hover:bg-white hover:text-[#9E472A] transition-all" do %>
          <span>Ketema Mats & Tibeb Textiles</span>
          <span class="text-xs text-[#D48B38] font-amharic">ቄጠማ እና ጥበብ</span>
        <% end %>
        <%= link_to ceremony_guide_path, data: { action: "click->mobile-menu#close" }, class: "flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-bold text-[#9E472A] bg-amber-50/50 hover:bg-white transition-all mt-1" do %>
          <span>The Sacred Ceremony Guide</span>
          <span class="text-xs text-[#9E472A]">Abol • Tona • Baraka →</span>
        <% end %>
      </div>

      <div class="pt-4 border-t border-[#EFE7DA] space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-semibold text-neutral-600">Active Currency:</span>
          <div class="flex items-center bg-[#140B07] rounded-lg p-0.5 border border-[#3A2016]">
            <%= button_to switch_currency_path(currency: "KES"), method: :post, form_class: "inline", class: "px-2.5 py-1 text-xs font-semibold rounded #{current_currency == 'KES' ? 'bg-[#D48B38] text-white' : 'text-neutral-300 hover:text-white'}" do %>
              🇰🇪 KES (KSh)
            <% end %>
            <%= button_to switch_currency_path(currency: "ETB"), method: :post, form_class: "inline", class: "px-2.5 py-1 text-xs font-semibold rounded #{current_currency == 'ETB' ? 'bg-[#D48B38] text-white' : 'text-neutral-300 hover:text-white'}" do %>
              🇪🇹 ETB (ብር)
            <% end %>
          </div>
        </div>

        <div class="flex items-center justify-between pt-2 text-xs">
          <a href="tel:+254707172370" class="font-semibold text-[#00A859] flex items-center">
            <svg class="w-3.5 h-3.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Hotline: +254 707 172370
          </a>
          <%= link_to "Admin Operations", admin_root_path, class: "text-neutral-500 hover:text-neutral-900 underline" %>
        </div>
      </div>
    </div>
  </header>

  <!-- Flash Notifications -->
  <% if notice.present? %>
    <div class="bg-[#183822] text-[#FAF6EE] px-4 py-3 text-center text-sm font-medium flex items-center justify-center space-x-2 border-b border-[#2A5A38]">
      <svg class="w-5 h-5 text-[#00A859]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
      <span><%= notice %></span>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="bg-[#9E472A] text-white px-4 py-3 text-center text-sm font-medium flex items-center justify-center space-x-2 border-b border-[#B55A3C]">
      <svg class="w-5 h-5 text-amber-200" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
      <span><%= alert %></span>
    </div>
  <% end %>

  <!-- Main View Content -->
  <main class="flex-grow">
    <%= yield %>
  </main>

  <!-- Slide-Over Shopping Cart Drawer (Hotwire Turbo Reactive) -->
  <div data-cart-target="backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden transition-opacity" data-action="click->cart#close"></div>
  <aside data-cart-target="drawer" class="fixed top-0 right-0 bottom-0 w-full max-w-md bg-[#FAF6EE] z-50 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col border-l border-[#EFE7DA]">
    <div class="p-6 bg-[#24130D] text-white flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-lg bg-[#3A2016] text-[#E5A652] flex items-center justify-center font-bold">YB</div>
        <div>
          <h3 class="font-serif text-lg font-bold text-[#EFE7DA]">Buna Basket</h3>
          <p class="text-xs text-[#E5A652]">Sovereign Ethiopian Coffee & Artifacts</p>
        </div>
      </div>
      <button type="button" data-action="click->cart#close" aria-label="Close basket" class="p-1.5 rounded-lg text-neutral-300 hover:text-white hover:bg-[#3A2016] transition-colors cursor-pointer">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Reactive Turbo Stream Frame for Cart Drawer -->
    <div id="cart-drawer-content" class="flex-1 flex flex-col justify-between overflow-hidden">
      <%= render "carts/cart_drawer" %>
    </div>
  </aside>

  <!-- Comprehensive Footer -->
  <footer class="bg-[#140B07] text-[#EFE7DA] border-t border-[#24130D] mt-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
        
        <!-- Brand Narrative -->
        <div class="space-y-4 md:col-span-1">
          <div class="flex items-center space-x-2">
            <div class="w-10 h-10 rounded-lg bg-[#24130D] text-[#E5A652] flex items-center justify-center font-serif font-bold text-xl">YB</div>
            <span class="font-serif text-xl font-bold text-white tracking-tight">Yebente Buna</span>
          </div>
          <p class="text-xs text-neutral-400 leading-relaxed">
            Direct Ethiopian Buna ceremonies exported directly to Kenya. Sourced from the ancient coffee forests of Kaffa, Yirgacheffe, and Sidamo, alongside authentic clay Jebenas and cultural ceremonial accessories.
          </p>
          <div class="pt-2">
            <span class="inline-block text-[11px] font-semibold text-[#D48B38] bg-[#24130D] px-2.5 py-1 rounded border border-[#3A2016]">
              Addis Ababa ➔ Moyale ➔ Nairobi
            </span>
          </div>
        </div>

        <!-- Product Categories -->
        <div class="space-y-3">
          <h4 class="font-serif text-sm font-semibold text-white tracking-wider uppercase">Authentic Sourcing</h4>
          <ul class="text-xs space-y-2 text-neutral-400">
            <li><%= link_to "Single-Origin Coffee Varieties", products_path(category: "coffee-varieties"), class: "hover:text-[#E5A652]" %></li>
            <li><%= link_to "Handcrafted Clay Jebenas", products_path(category: "traditional-brewing-hardware"), class: "hover:text-[#E5A652]" %></li>
            <li><%= link_to "Sini Ceramic Sets & Rekebots", products_path(category: "serving-ware"), class: "hover:text-[#E5A652]" %></li>
            <li><%= link_to "Milling & Fine Coffee Grinders", products_path(category: "modern-traditional-milling"), class: "hover:text-[#E5A652]" %></li>
            <li><%= link_to "Frankincense & Tenadam Herbs", products_path(category: "sensory-mood-enhancers"), class: "hover:text-[#E5A652]" %></li>
            <li><%= link_to "Ketema Mats & Tibeb Textiles", products_path(category: "spatial-aesthetics-decor"), class: "hover:text-[#E5A652]" %></li>
          </ul>
        </div>

        <!-- Regional Payment & Delivery -->
        <div class="space-y-3">
          <h4 class="font-serif text-sm font-semibold text-white tracking-wider uppercase">East African Logistics</h4>
          <div class="text-xs space-y-2 text-neutral-400">
            <p><strong>Primary Gateway:</strong> Safaricom M-Pesa Express (STK Push) & C2B Paybill 174379</p>
            <p><strong>Kenyan Hub:</strong> Nairobi Industrial Area Logistics Center</p>
            <p><strong>Border Transit:</strong> Moyale One-Stop Border Post (OSBP) Customs Cleared</p>
            <p><strong>Courier Partners:</strong> Fargo Courier East Africa, Sendy Express, DHL EA</p>
          </div>
        </div>

        <!-- Hardcoded Operational Contact Details -->
        <div class="space-y-3">
          <h4 class="font-serif text-sm font-semibold text-white tracking-wider uppercase">Merchant & Administration</h4>
          <div class="text-xs space-y-2 text-neutral-400">
            <p class="flex items-center text-white">
              <svg class="w-4 h-4 mr-2 text-[#00A859]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>Merchant Hotline: <strong>+254707172370</strong></span>
            </p>
            <p class="flex items-center text-white">
              <svg class="w-4 h-4 mr-2 text-[#D48B38]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span>System Admin: <strong>yebente@gmail.com</strong></span>
            </p>
            <p class="pt-2 text-neutral-400">Timezone: Africa/Nairobi (EAT, UTC+3)</p>
            <div class="pt-2">
              <%= link_to "Admin Operations Dashboard", admin_root_path, class: "text-neutral-400 hover:text-white underline text-[11px]" %>
            </div>
          </div>
        </div>

      </div>

      <div class="mt-12 pt-8 border-t border-[#24130D] flex flex-col sm:flex-row justify-between items-center text-xs text-neutral-500">
        <p>&copy; <%= Time.current.year %> Yebente Buna (የበንቴ ቡና). All rights reserved. Addis Ababa ➔ Nairobi.</p>
        <p class="mt-2 sm:mt-0">Sovereign VPS & Cloud Deployment Ready • Containerized Rails 7.1</p>
      </div>
    </div>
  </footer>

</body>
</html>

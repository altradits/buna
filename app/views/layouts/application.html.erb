<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <title><%= ENV.fetch("APP_NAME", "Yebente Buna") %> | Premium Authentic Ethiopian Coffee & Cultural Ceremony in Kenya</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Direct from Ethiopian highlands to Kenya: Authentic single-origin coffee, traditional clay Jebena pots, Sini cups, and ceremony incense.">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Google Fonts: Inter & Playfair Display -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <!-- Tailwind CSS via CDN / Asset Pipeline -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            buna: {
              dark: '#140B07',
              espresso: '#24130D',
              roast: '#3A2016',
              terracotta: '#9E472A',
              clay: '#B55A3C',
              amber: '#D48B38',
              gold: '#E5A652',
              sand: '#EFE7DA',
              parchment: '#FAF6EE',
              card: '#FDFBF7',
              forest: '#183822'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            serif: ['Playfair Display', 'Georgia', 'serif'],
            amharic: ['Nyala', 'Abyssinica SIL', 'Noto Sans Ethiopic', 'sans-serif']
          }
        }
      }
    }
  </script>

  <%= stylesheet_link_tag "application.tailwind", "data-turbo-track": "reload" rescue nil %>
  <%= javascript_importmap_tags rescue nil %>

  <style>
    body { background-color: #FAF6EE; color: #140B07; }
    .font-serif { font-family: 'Playfair Display', Georgia, serif; }
  </style>
</head>

<body class="min-h-full flex flex-col font-sans bg-[#FAF6EE] text-[#140B07]" data-controller="cart">
  
  <!-- Top Utility Bar: Clean & Minimal -->
  <div class="bg-[#24130D] text-[#EFE7DA] text-[11px] py-1.5 px-4 border-b border-[#3A2016]">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-3 text-neutral-300">
        <span class="text-[#E5A652] font-medium">
          Addis Ababa to Nairobi Corridor
        </span>
        <span class="hidden md:inline text-[#3A2016]">|</span>
        <span class="hidden md:inline text-neutral-400">Support: <strong class="text-white">+254707172370</strong></span>
      </div>

      <div class="flex items-center space-x-3">
        <!-- Multi-Currency Switcher KES / ETB -->
        <div class="flex items-center bg-[#140B07] rounded-md p-0.5 border border-[#3A2016]" data-controller="currency">
          <%= button_to switch_currency_path(currency: "KES"), method: :post, class: "px-2 py-0.5 text-[10px] font-semibold rounded #{current_currency == 'KES' ? 'bg-[#D48B38] text-white' : 'text-neutral-400 hover:text-white'}" do %>
            KES
          <% end %>
          <%= button_to switch_currency_path(currency: "ETB"), method: :post, class: "px-2 py-0.5 text-[10px] font-semibold rounded #{current_currency == 'ETB' ? 'bg-[#D48B38] text-white' : 'text-neutral-400 hover:text-white'}" do %>
            ETB
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Navigation Header: Streamlined & Focused -->
  <header class="bg-[#FAF6EE]/95 backdrop-blur-md sticky top-0 z-40 border-b border-[#EFE7DA] shadow-xs" data-controller="mobile-menu">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Brand Logo & Amharic Insignia -->
      <%= link_to root_path, class: "flex items-center space-x-2.5 group" do %>
        <div class="w-9 h-9 rounded-lg bg-[#24130D] text-[#E5A652] flex items-center justify-center shadow-xs group-hover:bg-[#140B07] transition-all">
          <span class="font-serif text-lg font-bold">YB</span>
        </div>
        <div class="flex flex-col">
          <div class="flex items-baseline space-x-1.5">
            <span class="font-serif text-lg sm:text-xl font-bold text-[#140B07] group-hover:text-[#9E472A] transition-colors leading-tight">Yebente Buna</span>
            <span class="text-xs font-semibold text-[#D48B38] font-amharic hidden sm:inline">የበንቴ ቡና</span>
          </div>
          <span class="text-[9px] text-neutral-500 uppercase tracking-wider hidden sm:block">Ethiopian Ceremony in Kenya</span>
        </div>
      <% end %>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-5 font-medium text-xs text-[#3A2016]">
        <%= link_to "All", root_path, class: "hover:text-[#9E472A] transition-colors #{'text-[#9E472A] font-bold' if params[:category].blank? && current_page?(root_path)}" %>
        <%= link_to "Coffee Varieties", root_path(category: "coffee-varieties"), class: "hover:text-[#9E472A] transition-colors #{'text-[#9E472A] font-bold' if params[:category] == 'coffee-varieties'}" %>
        <%= link_to "Brewing Hardware", root_path(category: "traditional-brewing-hardware"), class: "hover:text-[#9E472A] transition-colors #{'text-[#9E472A] font-bold' if params[:category] == 'traditional-brewing-hardware'}" %>
        <%= link_to "Serving Ware", root_path(category: "serving-ware"), class: "hover:text-[#9E472A] transition-colors #{'text-[#9E472A] font-bold' if params[:category] == 'serving-ware'}" %>
        <%= link_to "Milling", root_path(category: "modern-traditional-milling"), class: "hover:text-[#9E472A] transition-colors #{'text-[#9E472A] font-bold' if params[:category] == 'modern-traditional-milling'}" %>
        <%= link_to "Sensory & Mood", root_path(category: "sensory-mood-enhancers"), class: "hover:text-[#9E472A] transition-colors #{'text-[#9E472A] font-bold' if params[:category] == 'sensory-mood-enhancers'}" %>
        <%= link_to "Ceremony Guide", ceremony_guide_path, class: "text-[#9E472A] font-semibold hover:underline" %>
      </nav>

      <!-- Cart Drawer Trigger & Mobile Hamburger -->
      <div class="flex items-center space-x-2">
        <!-- Basket Trigger Button -->
        <button type="button" data-action="click->cart#open" aria-label="Open basket" class="relative p-2 rounded-lg bg-[#24130D] text-[#E5A652] hover:bg-[#140B07] transition-all shadow-xs cursor-pointer flex items-center space-x-1.5 text-xs font-semibold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span class="hidden sm:inline">Basket</span>
          <span id="cart-counter-badge" class="px-1.5 py-0.2 rounded-full bg-[#00A859] text-white text-[10px] font-bold">
            <%= cart_count %>
          </span>
        </button>

        <!-- Mobile Menu Toggle Button (lg:hidden) -->
        <button type="button" data-action="click->mobile-menu#toggle" aria-label="Toggle mobile menu" class="lg:hidden p-2 rounded-lg bg-white border border-[#EFE7DA] text-[#24130D] hover:bg-[#FAF6EE] transition-colors cursor-pointer">
          <svg data-mobile-menu-target="openIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg data-mobile-menu-target="closeIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer Dropdown -->
    <div data-mobile-menu-target="menu" class="hidden lg:hidden border-t border-[#EFE7DA] bg-[#FAF6EE] px-4 py-4 space-y-2 shadow-lg">
      <div class="space-y-1">
        <%= link_to "All Products", root_path, data: { action: "click->mobile-menu#close" }, class: "block px-3 py-2 rounded-lg text-xs font-semibold #{params[:category].blank? && current_page?(root_path) ? 'bg-[#24130D] text-[#E5A652]' : 'text-[#140B07] hover:bg-white hover:text-[#9E472A]'}" %>
        <%= link_to "Coffee Varieties", root_path(category: "coffee-varieties"), data: { action: "click->mobile-menu#close" }, class: "block px-3 py-2 rounded-lg text-xs font-semibold #{params[:category] == 'coffee-varieties' ? 'bg-[#24130D] text-[#E5A652]' : 'text-[#140B07] hover:bg-white hover:text-[#9E472A]'}" %>
        <%= link_to "Traditional Brewing Hardware", root_path(category: "traditional-brewing-hardware"), data: { action: "click->mobile-menu#close" }, class: "block px-3 py-2 rounded-lg text-xs font-semibold #{params[:category] == 'traditional-brewing-hardware' ? 'bg-[#24130D] text-[#E5A652]' : 'text-[#140B07] hover:bg-white hover:text-[#9E472A]'}" %>
        <%= link_to "Serving Ware", root_path(category: "serving-ware"), data: { action: "click->mobile-menu#close" }, class: "block px-3 py-2 rounded-lg text-xs font-semibold #{params[:category] == 'serving-ware' ? 'bg-[#24130D] text-[#E5A652]' : 'text-[#140B07] hover:bg-white hover:text-[#9E472A]'}" %>
        <%= link_to "Modern & Traditional Milling", root_path(category: "modern-traditional-milling"), data: { action: "click->mobile-menu#close" }, class: "block px-3 py-2 rounded-lg text-xs font-semibold #{params[:category] == 'modern-traditional-milling' ? 'bg-[#24130D] text-[#E5A652]' : 'text-[#140B07] hover:bg-white hover:text-[#9E472A]'}" %>
        <%= link_to "Sensory & Mood Enhancers", root_path(category: "sensory-mood-enhancers"), data: { action: "click->mobile-menu#close" }, class: "block px-3 py-2 rounded-lg text-xs font-semibold #{params[:category] == 'sensory-mood-enhancers' ? 'bg-[#24130D] text-[#E5A652]' : 'text-[#140B07] hover:bg-white hover:text-[#9E472A]'}" %>
        <%= link_to "Spatial Aesthetics & Decor", root_path(category: "spatial-aesthetics-decor"), data: { action: "click->mobile-menu#close" }, class: "block px-3 py-2 rounded-lg text-xs font-semibold #{params[:category] == 'spatial-aesthetics-decor' ? 'bg-[#24130D] text-[#E5A652]' : 'text-[#140B07] hover:bg-white hover:text-[#9E472A]'}" %>
        <%= link_to "Sacred Ceremony Guide", ceremony_guide_path, data: { action: "click->mobile-menu#close" }, class: "block px-3 py-2 rounded-lg text-xs font-bold text-[#9E472A] bg-amber-50/60" %>
      </div>

      <div class="pt-3 border-t border-[#EFE7DA] flex items-center justify-between text-xs">
        <a href="tel:+254707172370" class="font-medium text-[#00A859]">+254 707 172370</a>
        <%= link_to "Admin Operations", admin_root_path, class: "text-neutral-500 hover:underline text-[11px]" %>
      </div>
    </div>
  </header>

  <!-- Flash Notifications: Clean & Icon-free -->
  <% if notice.present? %>
    <div class="bg-[#183822] text-[#FAF6EE] px-4 py-2 text-center text-xs font-medium border-b border-[#2A5A38]">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="bg-[#9E472A] text-white px-4 py-2 text-center text-xs font-medium border-b border-[#B55A3C]">
      <%= alert %>
    </div>
  <% end %>

  <!-- Main View Content -->
  <main class="flex-grow">
    <%= yield %>
  </main>

  <!-- Slide-Over Shopping Cart Drawer (Hotwire Turbo Reactive) -->
  <div data-cart-target="backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300 ease-out cursor-pointer" data-action="click->cart#close"></div>
  <aside data-cart-target="drawer" class="fixed top-0 right-0 bottom-0 w-full max-w-md bg-[#FAF6EE] z-50 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col border-l border-[#EFE7DA]">
    <div class="p-5 bg-[#24130D] text-white flex items-center justify-between border-b border-[#3A2016]">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-[#3A2016] text-[#E5A652] flex items-center justify-center font-bold text-base shadow-sm">YB</div>
        <div>
          <div class="flex items-baseline space-x-1.5">
            <h3 class="font-serif text-lg font-bold text-[#EFE7DA]">Buna Basket</h3>
            <span class="text-xs font-mono text-[#E5A652]">(<span id="drawer-item-count"><%= cart_count %></span>)</span>
          </div>
          <p class="text-[11px] text-[#E5A652] font-amharic">የበንቴ ቡና ቅርጫት</p>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <div class="flex items-center bg-[#140B07] rounded-lg p-0.5 border border-[#3A2016]">
          <%= button_to switch_currency_path(currency: "KES"), method: :post, form_class: "inline", class: "px-2 py-0.5 text-[10px] font-bold rounded #{current_currency == 'KES' ? 'bg-[#D48B38] text-white' : 'text-neutral-400 hover:text-white'}" do %>
            KES
          <% end %>
          <%= button_to switch_currency_path(currency: "ETB"), method: :post, form_class: "inline", class: "px-2 py-0.5 text-[10px] font-bold rounded #{current_currency == 'ETB' ? 'bg-[#D48B38] text-white' : 'text-neutral-400 hover:text-white'}" do %>
            ETB
          <% end %>
        </div>

        <button type="button" data-action="click->cart#close" aria-label="Close basket" class="p-1.5 rounded-lg text-neutral-300 hover:text-white hover:bg-[#3A2016] transition-colors cursor-pointer">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- Reactive Turbo Stream Frame for Cart Drawer -->
    <div id="cart-drawer-content" class="flex-1 flex flex-col justify-between overflow-hidden">
      <%= render "carts/cart_drawer" %>
    </div>
  </aside>

  <!-- Minimal Streamlined Footer -->
  <footer class="bg-[#140B07] text-[#EFE7DA] border-t border-[#24130D] mt-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Brand Narrative -->
        <div class="space-y-2">
          <div class="flex items-center space-x-2">
            <div class="w-8 h-8 rounded-lg bg-[#24130D] text-[#E5A652] flex items-center justify-center font-serif font-bold text-base">YB</div>
            <span class="font-serif text-lg font-bold text-white tracking-tight">Yebente Buna</span>
          </div>
          <p class="text-xs text-neutral-400 leading-relaxed max-w-sm">
            Authentic Ethiopian Buna ceremonies sourced from Kaffa, Sidamo & Yirgacheffe, delivered across Kenya via Moyale OSBP.
          </p>
          <div class="pt-1">
            <span class="inline-block text-[10px] font-semibold text-[#D48B38] bg-[#24130D] px-2 py-0.5 rounded border border-[#3A2016]">
              Addis Ababa – Moyale – Nairobi
            </span>
          </div>
        </div>

        <!-- Product Categories -->
        <div class="space-y-2">
          <h4 class="font-serif text-xs font-semibold text-white tracking-wider uppercase">Sourcing</h4>
          <ul class="text-xs space-y-1.5 text-neutral-400">
            <li><%= link_to "Single-Origin Coffee", products_path(category: "coffee-varieties"), class: "hover:text-[#E5A652]" %></li>
            <li><%= link_to "Clay Jebenas & Hardware", products_path(category: "traditional-brewing-hardware"), class: "hover:text-[#E5A652]" %></li>
            <li><%= link_to "Sini Ceramic Sets & Rekebots", products_path(category: "serving-ware"), class: "hover:text-[#E5A652]" %></li>
            <li><%= link_to "Grinders & Accessories", products_path(category: "modern-traditional-milling"), class: "hover:text-[#E5A652]" %></li>
          </ul>
        </div>

        <!-- Operations & Admin -->
        <div class="space-y-2">
          <h4 class="font-serif text-xs font-semibold text-white tracking-wider uppercase">Support & Logistics</h4>
          <div class="text-xs space-y-1 text-neutral-400">
            <p>Hotline: <strong class="text-white">+254707172370</strong></p>
            <p>Email: <strong class="text-white">yebente@gmail.com</strong></p>
            <div class="pt-1.5">
              <%= link_to "Admin Operations Dashboard", admin_root_path, class: "text-neutral-400 hover:text-white underline text-[11px]" %>
            </div>
          </div>
        </div>

      </div>

      <div class="mt-8 pt-4 border-t border-[#24130D] flex flex-col sm:flex-row justify-between items-center text-[11px] text-neutral-500">
        <p>&copy; <%= Time.current.year %> Yebente Buna (የበንቴ ቡና). All rights reserved.</p>
        <p class="mt-1 sm:mt-0">Containerized Rails 7.1 • Moyale Customs Cleared</p>
      </div>
    </div>
  </footer>

</body>
</html>

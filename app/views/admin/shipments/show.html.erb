<div class="space-y-4 max-w-4xl mx-auto">
  <div class="flex items-center justify-between border-b border-slate-800 pb-3">
    <div>
      <h2 class="text-lg font-bold text-white tracking-tight">Consignment Checkpoint Management</h2>
      <p class="text-xs text-slate-400">Waybill: <strong class="text-amber-400 font-mono"><%= @shipment.tracking_number %></strong></p>
    </div>
    <%= link_to "← Back to Shipments", admin_shipments_path, class: "text-xs text-slate-400 hover:text-white" %>
  </div>

  <div class="bg-slate-900 p-4 sm:p-5 rounded-xl border border-slate-800 space-y-4">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs bg-slate-950/60 p-3 rounded-lg border border-slate-800/80">
      <div>
        <span class="text-slate-500 block text-[10px] uppercase">Order</span>
        <span class="text-white font-mono font-medium"><%= @shipment.order.order_number %></span>
      </div>
      <div>
        <span class="text-slate-500 block text-[10px] uppercase">Recipient</span>
        <span class="text-white"><%= @shipment.order.customer_name %></span>
      </div>
      <div>
        <span class="text-slate-500 block text-[10px] uppercase">Courier</span>
        <span class="text-emerald-400 font-medium"><%= @shipment.courier_provider %></span>
      </div>
      <div>
        <span class="text-slate-500 block text-[10px] uppercase">Destination</span>
        <span class="text-slate-300 truncate block"><%= @shipment.order.delivery_city %></span>
      </div>
    </div>

    <!-- Update Status Form -->
    <div class="pt-3 border-t border-slate-800 space-y-3">
      <h3 class="text-xs font-bold text-white uppercase tracking-wider">Advance Cross-Border Milestone</h3>
      
      <%= form_with url: update_status_admin_shipment_path(@shipment), method: :post, local: true, class: "space-y-3" do |f| %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-[11px] font-medium text-slate-400 mb-1">New Milestone Status</label>
            <%= f.select :status, ShippingShipment::CHECKPOINTS.map { |c| ["#{c[:label]} (#{c[:amharic]})", c[:code]] }, { selected: @shipment.status }, class: "w-full text-xs p-2 rounded-lg bg-slate-800 border border-slate-700 text-white" %>
          </div>

          <div>
            <label class="block text-[11px] font-medium text-slate-400 mb-1">Checkpoint Clearance Notes</label>
            <%= f.text_field :notes, placeholder: "e.g. Cleared Moyale OSBP booth #4", class: "w-full text-xs p-2 rounded-lg bg-slate-800 border border-slate-700 text-white" %>
          </div>
        </div>

        <div>
          <%= f.submit "Update Checkpoint", class: "px-4 py-2 rounded-lg bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold text-xs cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

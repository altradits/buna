<div class="space-y-6 max-w-4xl mx-auto">
  <div class="flex items-center justify-between border-b border-slate-800 pb-4">
    <div>
      <h2 class="text-xl font-bold text-white">Consignment Checkpoint Management</h2>
      <p class="text-xs text-slate-400">Waybill: <strong class="text-amber-400 font-mono"><%= @shipment.tracking_number %></strong></p>
    </div>
    <%= link_to "← Back to Shipments", admin_shipments_path, class: "text-xs text-slate-400 hover:text-white" %>
  </div>

  <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800 space-y-6">
    <div class="grid grid-cols-2 gap-4 text-xs">
      <div><span class="text-slate-500">Order:</span> <span class="text-white font-mono"><%= @shipment.order.order_number %></span></div>
      <div><span class="text-slate-500">Recipient:</span> <span class="text-white"><%= @shipment.order.customer_name %> (<%= @shipment.order.customer_phone %>)</span></div>
      <div><span class="text-slate-500">Delivery Address:</span> <span class="text-white"><%= @shipment.order.delivery_address %>, <%= @shipment.order.delivery_city %></span></div>
      <div><span class="text-slate-500">Courier Partner:</span> <span class="text-emerald-400 font-semibold"><%= @shipment.courier_provider %></span></div>
    </div>

    <!-- Update Status Form -->
    <div class="pt-6 border-t border-slate-800 space-y-4">
      <h3 class="text-sm font-bold text-white">Advance Cross-Border Milestone</h3>
      
      <%= form_with url: update_status_admin_shipment_path(@shipment), method: :post, local: true, class: "space-y-4" do |f| %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">New Milestone Status</label>
            <%= f.select :status, ShippingShipment::CHECKPOINTS.map { |c| ["#{c[:label]} (#{c[:amharic]})", c[:code]] }, { selected: @shipment.status }, class: "w-full text-xs p-2.5 rounded-lg bg-slate-800 border border-slate-700 text-white" %>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-400 mb-1">Checkpoint Clearance Notes</label>
            <%= f.text_field :notes, placeholder: "e.g. Cleared Moyale OSBP customs booth #4", class: "w-full text-xs p-2.5 rounded-lg bg-slate-800 border border-slate-700 text-white" %>
          </div>
        </div>

        <div>
          <%= f.submit "Update Waybill Checkpoint", class: "px-5 py-2.5 rounded-lg bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold text-xs cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

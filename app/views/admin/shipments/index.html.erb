<div class="space-y-4">
  <div class="flex items-center justify-between pb-2 border-b border-slate-800">
    <div>
      <h2 class="text-xl font-bold text-white tracking-tight">Cross-Border Consignments</h2>
      <p class="text-xs text-slate-400">Addis Ababa Hub – Moyale OSBP Border – Nairobi Hub – Last-Mile Dispatch</p>
    </div>
  </div>

  <div class="p-4 sm:p-5 rounded-xl bg-slate-900 border border-slate-800">
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left text-slate-300">
        <thead class="text-slate-400 uppercase text-[10px] border-b border-slate-800">
          <tr>
            <th class="py-2.5 px-3">Waybill #</th>
            <th class="py-2.5 px-3">Order #</th>
            <th class="py-2.5 px-3">Destination</th>
            <th class="py-2.5 px-3">Courier</th>
            <th class="py-2.5 px-3">Current Checkpoint</th>
            <th class="py-2.5 px-3">Status</th>
            <th class="py-2.5 px-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% if @shipments.empty? %>
            <tr><td colspan="7" class="py-4 text-center text-slate-500">No shipments manifested yet.</td></tr>
          <% else %>
            <% @shipments.each do |shipment| %>
              <tr class="hover:bg-slate-800/40">
                <td class="py-2.5 px-3 font-mono text-amber-400 font-semibold"><%= shipment.tracking_number %></td>
                <td class="py-2.5 px-3 text-slate-300"><%= shipment.order.order_number %></td>
                <td class="py-2.5 px-3 text-slate-300"><%= shipment.destination_hub %></td>
                <td class="py-2.5 px-3 text-emerald-400 font-medium"><%= shipment.courier_provider %></td>
                <td class="py-2.5 px-3 text-slate-300"><%= shipment.current_checkpoint.presence || "Addis Ababa Central Hub" %></td>
                <td class="py-2.5 px-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-900/60 text-blue-300">
                    <%= shipment.status.humanize %>
                  </span>
                </td>
                <td class="py-2.5 px-3 text-right">
                  <%= link_to "Manage Milestone", admin_shipment_path(shipment), class: "text-amber-400 hover:underline" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

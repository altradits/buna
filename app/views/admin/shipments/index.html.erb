<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-white">East African Cross-Border Consignments</h2>
      <p class="text-xs text-slate-400">Addis Ababa Bole Hub ➔ Moyale OSBP Border ➔ Nairobi Hub ➔ Last-Mile Courier</p>
    </div>
  </div>

  <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800">
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left text-slate-300">
        <thead class="text-slate-400 uppercase border-b border-slate-800">
          <tr>
            <th class="py-3 px-4">Waybill Tracking #</th>
            <th class="py-3 px-4">Order #</th>
            <th class="py-3 px-4">Destination</th>
            <th class="py-3 px-4">Courier</th>
            <th class="py-3 px-4">Current Checkpoint</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% if @shipments.empty? %>
            <tr><td colspan="7" class="py-6 text-center text-slate-500">No shipments manifested yet.</td></tr>
          <% else %>
            <% @shipments.each do |shipment| %>
              <tr class="hover:bg-slate-800/50">
                <td class="py-3 px-4 font-mono text-amber-400"><%= shipment.tracking_number %></td>
                <td class="py-3 px-4"><%= shipment.order.order_number %></td>
                <td class="py-3 px-4"><%= shipment.destination_hub %></td>
                <td class="py-3 px-4"><%= shipment.courier_provider %></td>
                <td class="py-3 px-4"><%= shipment.current_checkpoint.presence || "Addis Ababa Central Hub" %></td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-900/60 text-blue-300">
                    <%= shipment.status.humanize %>
                  </span>
                </td>
                <td class="py-3 px-4">
                  <%= link_to "Manage & Checkpoint", admin_shipment_path(shipment), class: "text-amber-400 hover:underline" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

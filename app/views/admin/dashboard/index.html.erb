<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-slate-800">
    <div>
      <h2 class="text-xl font-bold text-white tracking-tight">Commercial & Operations Dashboard</h2>
      <p class="text-xs text-slate-400">Regional sales analytics, M-Pesa settlements, and cross-border consignments.</p>
    </div>
    <div class="text-[11px] text-amber-400 font-mono bg-slate-900 px-2.5 py-1 rounded border border-slate-800 self-start sm:self-auto">
      EAT: <%= Time.current.strftime("%H:%M:%S") %>
    </div>
  </div>

  <!-- KPI Metric Cards: Compact & Clear -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
      <span class="text-[11px] text-slate-400 uppercase font-semibold tracking-wider">Revenue (KES)</span>
      <div class="text-xl font-bold text-emerald-400 mt-1"><%= CurrencyHelper.format_money(@total_revenue_kes, "KES") %></div>
      <div class="text-[10px] text-slate-500 mt-0.5">Paid customer checkouts</div>
    </div>

    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
      <span class="text-[11px] text-slate-400 uppercase font-semibold tracking-wider">Revenue (ETB)</span>
      <div class="text-xl font-bold text-amber-400 mt-1"><%= CurrencyHelper.format_money(@total_revenue_etb, "ETB") %></div>
      <div class="text-[10px] text-slate-500 mt-0.5">Converted @ 0.88 ETB/KES</div>
    </div>

    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
      <span class="text-[11px] text-slate-400 uppercase font-semibold tracking-wider">Confirmed Orders</span>
      <div class="text-xl font-bold text-white mt-1"><%= @paid_orders_count %></div>
      <div class="text-[10px] text-slate-500 mt-0.5"><%= @pending_orders_count %> pending payment</div>
    </div>

    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
      <span class="text-[11px] text-slate-400 uppercase font-semibold tracking-wider">Active Shipments</span>
      <div class="text-xl font-bold text-blue-400 mt-1"><%= @active_shipments.count %></div>
      <div class="text-[10px] text-slate-500 mt-0.5">Moyale corridor in transit</div>
    </div>
  </div>

  <!-- Recent Orders Table -->
  <div class="p-4 sm:p-5 rounded-xl bg-slate-900 border border-slate-800 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-white tracking-wide">Recent Customer Consignments</h3>
      <%= link_to "View all orders →", admin_orders_path, class: "text-xs text-amber-400 hover:underline" %>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left text-slate-300">
        <thead class="text-slate-400 uppercase text-[10px] border-b border-slate-800">
          <tr>
            <th class="py-2.5 px-3">Order #</th>
            <th class="py-2.5 px-3">Customer</th>
            <th class="py-2.5 px-3">Phone</th>
            <th class="py-2.5 px-3">Destination</th>
            <th class="py-2.5 px-3">Amount</th>
            <th class="py-2.5 px-3">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% if @recent_orders.empty? %>
            <tr><td colspan="6" class="py-4 text-center text-slate-500">No customer orders placed yet.</td></tr>
          <% else %>
            <% @recent_orders.each do |order| %>
              <tr class="hover:bg-slate-800/40">
                <td class="py-2.5 px-3 font-mono text-amber-400"><%= link_to order.order_number, admin_order_path(order), class: "hover:underline" %></td>
                <td class="py-2.5 px-3"><%= order.customer_name %></td>
                <td class="py-2.5 px-3 font-mono text-slate-400"><%= order.customer_phone %></td>
                <td class="py-2.5 px-3"><%= order.delivery_city %>, <%= order.delivery_county %></td>
                <td class="py-2.5 px-3 font-semibold text-white"><%= CurrencyHelper.format_money(order.total_kes, "KES") %></td>
                <td class="py-2.5 px-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-semibold <%= order.paid? ? 'bg-emerald-900/60 text-emerald-300' : 'bg-amber-900/60 text-amber-300' %>">
                    <%= order.status.humanize %>
                  </span>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Payment Gateway Transactions -->
  <div class="p-4 sm:p-5 rounded-xl bg-slate-900 border border-slate-800 space-y-3">
    <h3 class="text-sm font-bold text-white tracking-wide">Gateway Transaction Log</h3>
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left text-slate-300">
        <thead class="text-slate-400 uppercase text-[10px] border-b border-slate-800">
          <tr>
            <th class="py-2.5 px-3">Receipt #</th>
            <th class="py-2.5 px-3">Type</th>
            <th class="py-2.5 px-3">Phone</th>
            <th class="py-2.5 px-3">Amount</th>
            <th class="py-2.5 px-3">Code</th>
            <th class="py-2.5 px-3">Status</th>
            <th class="py-2.5 px-3">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% if @recent_mpesa_transactions.empty? %>
            <tr><td colspan="7" class="py-4 text-center text-slate-500">No transactions logged yet.</td></tr>
          <% else %>
            <% @recent_mpesa_transactions.each do |tx| %>
              <tr class="hover:bg-slate-800/40">
                <td class="py-2.5 px-3 font-mono text-emerald-400"><%= tx.mpesa_receipt_number.presence || tx.checkout_request_id %></td>
                <td class="py-2.5 px-3 text-slate-400"><%= tx.transaction_type %></td>
                <td class="py-2.5 px-3 font-mono"><%= tx.phone_number %></td>
                <td class="py-2.5 px-3 font-semibold text-white"><%= CurrencyHelper.format_money(tx.amount, "KES") %></td>
                <td class="py-2.5 px-3 font-mono text-slate-400"><%= tx.result_code || "pending" %></td>
                <td class="py-2.5 px-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-semibold <%= tx.success? ? 'bg-emerald-900/60 text-emerald-300' : 'bg-rose-900/60 text-rose-300' %>">
                    <%= tx.status %>
                  </span>
                </td>
                <td class="py-2.5 px-3 text-slate-400"><%= (tx.transaction_date || tx.created_at).strftime("%d/%m/%Y %H:%M") %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>

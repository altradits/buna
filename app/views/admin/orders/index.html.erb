<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-white">Customer Orders Management</h2>
      <p class="text-xs text-slate-400">All Kenyan customer consignments and Safaricom M-Pesa checkouts.</p>
    </div>
  </div>

  <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800">
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left text-slate-300">
        <thead class="text-slate-400 uppercase border-b border-slate-800">
          <tr>
            <th class="py-3 px-4">Order #</th>
            <th class="py-3 px-4">Date</th>
            <th class="py-3 px-4">Customer</th>
            <th class="py-3 px-4">Phone (M-Pesa)</th>
            <th class="py-3 px-4">Amount</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% if @orders.empty? %>
            <tr><td colspan="7" class="py-6 text-center text-slate-500">No customer orders placed yet.</td></tr>
          <% else %>
            <% @orders.each do |order| %>
              <tr class="hover:bg-slate-800/50">
                <td class="py-3 px-4 font-mono text-amber-400"><%= link_to order.order_number, admin_order_path(order) %></td>
                <td class="py-3 px-4"><%= order.created_at.strftime("%d/%m/%Y %H:%M") %></td>
                <td class="py-3 px-4"><%= order.customer_name %></td>
                <td class="py-3 px-4 font-mono text-emerald-400"><%= order.customer_phone %></td>
                <td class="py-3 px-4 font-bold text-white"><%= CurrencyHelper.format_money(order.total_kes, "KES") %></td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded text-[10px] font-semibold <%= order.paid? ? 'bg-emerald-900/60 text-emerald-300' : 'bg-amber-900/60 text-amber-300' %>">
                    <%= order.status.humanize %>
                  </span>
                </td>
                <td class="py-3 px-4">
                  <%= link_to "View Details", admin_order_path(order), class: "text-amber-400 hover:underline mr-2" %>
                  <%= link_to "Customer View", order_path(order), class: "text-slate-400 hover:underline" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

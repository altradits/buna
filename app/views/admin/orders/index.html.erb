<div class="space-y-4">
  <div class="flex items-center justify-between pb-2 border-b border-slate-800">
    <div>
      <h2 class="text-xl font-bold text-white tracking-tight">Customer Orders Management</h2>
      <p class="text-xs text-slate-400">All customer consignments and orders.</p>
    </div>
  </div>

  <div class="p-4 sm:p-5 rounded-xl bg-slate-900 border border-slate-800">
    <div class="overflow-x-auto">
      <table class="w-full text-xs text-left text-slate-300">
        <thead class="text-slate-400 uppercase text-[10px] border-b border-slate-800">
          <tr>
            <th class="py-2.5 px-3">Order #</th>
            <th class="py-2.5 px-3">Date</th>
            <th class="py-2.5 px-3">Customer</th>
            <th class="py-2.5 px-3">Phone</th>
            <th class="py-2.5 px-3">Amount</th>
            <th class="py-2.5 px-3">Status</th>
            <th class="py-2.5 px-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% if @orders.empty? %>
            <tr><td colspan="7" class="py-4 text-center text-slate-500">No customer orders placed yet.</td></tr>
          <% else %>
            <% @orders.each do |order| %>
              <tr class="hover:bg-slate-800/40">
                <td class="py-2.5 px-3 font-mono text-amber-400"><%= link_to order.order_number, admin_order_path(order), class: "hover:underline" %></td>
                <td class="py-2.5 px-3 text-slate-400"><%= order.created_at.strftime("%d/%m/%Y %H:%M") %></td>
                <td class="py-2.5 px-3 text-white"><%= order.customer_name %></td>
                <td class="py-2.5 px-3 font-mono text-emerald-400"><%= order.customer_phone %></td>
                <td class="py-2.5 px-3 font-semibold text-white"><%= CurrencyHelper.format_money(order.total_kes, "KES") %></td>
                <td class="py-2.5 px-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-semibold <%= order.paid? ? 'bg-emerald-900/60 text-emerald-300' : 'bg-amber-900/60 text-amber-300' %>">
                    <%= order.status.humanize %>
                  </span>
                </td>
                <td class="py-2.5 px-3 text-right space-x-2">
                  <%= link_to "Manage", admin_order_path(order), class: "text-amber-400 hover:underline" %>
                  <span class="text-slate-600">|</span>
                  <%= link_to "Storefront", order_path(order), class: "text-slate-400 hover:underline" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

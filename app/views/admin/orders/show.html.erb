<div class="space-y-4 max-w-4xl mx-auto">
  <div class="flex items-center justify-between border-b border-slate-800 pb-3">
    <div>
      <h2 class="text-lg font-bold text-white tracking-tight">Order <%= @order.order_number %></h2>
      <p class="text-xs text-slate-400">Placed on <%= @order.created_at.strftime("%B %d, %Y at %H:%M EAT") %></p>
    </div>
    <div class="space-x-3 text-xs">
      <%= link_to "Back to Orders", admin_orders_path, class: "text-slate-400 hover:text-white" %>
      <%= link_to "Storefront View", order_path(@order), class: "text-amber-400 hover:underline" %>
    </div>
  </div>

  <div class="bg-slate-900 p-4 sm:p-5 rounded-xl border border-slate-800 space-y-4">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs bg-slate-950/60 p-3 rounded-lg border border-slate-800/80">
      <div>
        <span class="text-slate-500 block text-[10px] uppercase">Customer</span>
        <span class="text-white font-semibold"><%= @order.customer_name %></span>
      </div>
      <div>
        <span class="text-slate-500 block text-[10px] uppercase">Phone (M-Pesa)</span>
        <span class="text-emerald-400 font-mono font-bold"><%= @order.customer_phone %></span>
      </div>
      <div>
        <span class="text-slate-500 block text-[10px] uppercase">Email</span>
        <span class="text-slate-300 truncate block"><%= @order.customer_email %></span>
      </div>
      <div>
        <span class="text-slate-500 block text-[10px] uppercase">Status</span>
        <span class="font-bold <%= @order.paid? ? 'text-emerald-400' : 'text-amber-400' %>"><%= @order.status.humanize %></span>
      </div>
      <div class="col-span-2 sm:col-span-4 pt-1 border-t border-slate-800/60">
        <span class="text-slate-500 text-[10px] uppercase mr-1">Delivery Address:</span>
        <span class="text-slate-300"><%= @order.delivery_address %>, <%= @order.delivery_city %>, <%= @order.delivery_county %></span>
      </div>
    </div>

    <!-- Items Table -->
    <div class="pt-2 space-y-2">
      <h3 class="text-xs font-bold text-white uppercase tracking-wider">Consignment Items</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left text-slate-300">
          <thead class="text-slate-400 uppercase text-[10px] border-b border-slate-800">
            <tr>
              <th class="py-2 px-2">Product</th>
              <th class="py-2 px-2">Format</th>
              <th class="py-2 px-2 text-center">Qty</th>
              <th class="py-2 px-2 text-right">Unit Price</th>
              <th class="py-2 px-2 text-right">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            <% @order.order_items.each do |item| %>
              <tr class="hover:bg-slate-800/40">
                <td class="py-2 px-2 text-white font-medium"><%= item.product.name %></td>
                <td class="py-2 px-2 text-slate-400"><%= item.selected_format.presence || "Standard" %></td>
                <td class="py-2 px-2 text-center"><%= item.quantity %></td>
                <td class="py-2 px-2 text-right text-slate-300"><%= CurrencyHelper.format_money(item.unit_price_kes, "KES") %></td>
                <td class="py-2 px-2 text-right font-semibold text-white"><%= CurrencyHelper.format_money(item.total_price_kes, "KES") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="pt-3 border-t border-slate-800 text-right text-xs space-y-0.5">
        <div class="text-slate-400">Subtotal: <strong class="text-slate-200"><%= CurrencyHelper.format_money(@order.subtotal_kes, "KES") %></strong></div>
        <div class="text-slate-400">Shipping: <strong class="text-slate-200"><%= CurrencyHelper.format_money(@order.shipping_fee_kes, "KES") %></strong></div>
        <div class="text-sm text-amber-400 font-bold pt-1">Total: <%= CurrencyHelper.format_money(@order.total_kes, "KES") %></div>
      </div>
    </div>
  </div>
</div>

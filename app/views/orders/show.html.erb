<div class="py-12 bg-[#FAF6EE]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Real-time Turbo Stream Channel Subscription -->
    <%= turbo_stream_from "order_#{@order.id}" %>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#EFE7DA] pb-6">
      <div>
        <span class="text-xs font-bold text-[#9E472A] uppercase tracking-widest">Order Details</span>
        <h1 class="font-serif text-3xl font-bold text-[#140B07]">Consignment #<%= @order.order_number %></h1>
        <p class="text-xs text-neutral-500 mt-1">Placed on <%= @order.created_at.strftime("%B %d, %Y at %H:%M EAT") %></p>
      </div>

      <div class="flex items-center space-x-3">
        <span class="px-3 py-1.5 rounded-full text-xs font-bold <%= @order.paid? ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-amber-100 text-amber-800 border border-amber-300' %>">
          <%= @order.status.humanize %>
        </span>
        <button type="button" onclick="window.print()" class="text-xs text-neutral-600 hover:text-black underline cursor-pointer flex items-center space-x-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          <span>Print Receipt</span>
        </button>
      </div>
    </div>

    <!-- Live Reactive Status Section -->
    <%= render "orders/status_section", order: @order %>

    <!-- Order Items & Shipping Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Consignment Items -->
      <div class="bg-white p-6 rounded-3xl border border-[#EFE7DA] shadow-sm space-y-4">
        <h3 class="font-serif text-lg font-bold text-[#140B07] border-b border-[#EFE7DA] pb-3">Items in Consignment</h3>
        <div class="divide-y divide-[#EFE7DA] text-xs">
          <% @order.order_items.each do |item| %>
            <div class="py-3 flex justify-between items-start">
              <div>
                <div class="font-bold text-[#140B07]"><%= item.product.name %></div>
                <div class="text-[11px] text-neutral-500">
                  Format: <%= item.selected_format.presence || "Standard" %> • Qty: <%= item.quantity %>
                </div>
              </div>
              <div class="font-bold text-[#9E472A]">
                <%= CurrencyHelper.format_money(item.total_price_kes, "KES") %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="pt-4 border-t border-[#EFE7DA] space-y-1.5 text-xs">
          <div class="flex justify-between text-neutral-600">
            <span>Subtotal:</span>
            <span><%= CurrencyHelper.format_money(@order.subtotal_kes, "KES") %></span>
          </div>
          <div class="flex justify-between text-neutral-600">
            <span>Cross-Border Logistics:</span>
            <span><%= CurrencyHelper.format_money(@order.shipping_fee_kes, "KES") %></span>
          </div>
          <div class="flex justify-between font-bold text-sm text-[#140B07] pt-2 border-t border-[#EFE7DA]">
            <span>Total:</span>
            <span class="text-[#9E472A]"><%= CurrencyHelper.format_money(@order.total_kes, "KES") %></span>
          </div>
          <div class="text-right text-[11px] text-neutral-500">
            Converted: <%= CurrencyHelper.format_money(@order.total_etb, "ETB") %>
          </div>
        </div>
      </div>

      <!-- Delivery & Cross-Border Logistics Info -->
      <div class="bg-white p-6 rounded-3xl border border-[#EFE7DA] shadow-sm space-y-4">
        <h3 class="font-serif text-lg font-bold text-[#140B07] border-b border-[#EFE7DA] pb-3">Cross-Border Routing</h3>
        
        <div class="text-xs space-y-3 text-neutral-700">
          <div>
            <span class="block text-neutral-400 text-[10px] uppercase font-bold">Recipient</span>
            <span class="font-semibold text-[#140B07]"><%= @order.customer_name %></span>
          </div>

          <div>
            <span class="block text-neutral-400 text-[10px] uppercase font-bold">Destination</span>
            <p><%= @order.delivery_address %>, <%= @order.delivery_city %>, <%= @order.delivery_county %>, Kenya</p>
          </div>

          <div>
            <span class="block text-neutral-400 text-[10px] uppercase font-bold">Contact Phone (M-Pesa)</span>
            <span class="font-bold text-[#00A859]"><%= @order.customer_phone %></span>
          </div>

          <div class="pt-3 border-t border-[#EFE7DA] space-y-2">
            <div>
              <span class="block text-neutral-400 text-[10px] uppercase font-bold">Origin Logistics Hub</span>
              <span class="font-semibold text-[#24130D]">Addis Ababa Bole Central Hub (Ethiopia)</span>
            </div>
            <div>
              <span class="block text-neutral-400 text-[10px] uppercase font-bold">Border Crossing Station</span>
              <span class="font-semibold text-[#24130D]">Moyale One-Stop Border Post (OSBP) Customs Cleared</span>
            </div>
            <div>
              <span class="block text-neutral-400 text-[10px] uppercase font-bold">Assigned Courier</span>
              <span class="font-semibold text-[#D48B38]"><%= @order.courier_provider %></span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</div>

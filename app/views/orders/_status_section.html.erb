<div id="order_status_section" class="bg-white p-5 sm:p-6 rounded-2xl border border-[#EFE7DA] shadow-xs space-y-4">
  
  <% if order.paid? %>
    <!-- Paid Success Banner: Clean & Crisp -->
    <div class="p-5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 space-y-2.5">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-full bg-[#00A859] text-white flex items-center justify-center font-bold text-sm shadow-xs">
          ✓
        </div>
        <div>
          <h2 class="font-serif text-lg font-bold text-[#006C38]">Payment Confirmed via M-Pesa</h2>
          <p class="text-xs text-emerald-700">Receipt: <strong><%= order.mpesa_transaction&.mpesa_receipt_number.presence || "MPESA-CONFIRMED" %></strong></p>
        </div>
      </div>
      <p class="text-xs text-emerald-800">
        Amount paid: <strong><%= CurrencyHelper.format_money(order.total_kes, "KES") %></strong>. Consignment is prepared for dispatch.
      </p>

      <div class="pt-1 flex flex-wrap gap-2">
        <%= link_to track_order_path(order), class: "px-4 py-2 rounded-lg bg-[#00A859] hover:bg-[#008F4C] text-white text-xs font-bold shadow-xs transition-all inline-flex items-center space-x-1.5" do %>
          <span>Track Delivery</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        <% end %>
        <%= link_to "Continue Shopping", products_path, class: "px-4 py-2 rounded-lg bg-white border border-emerald-300 text-emerald-800 text-xs font-semibold hover:bg-emerald-100 transition-colors inline-flex items-center" %>
      </div>
    </div>

  <% elsif order.status == "payment_processing" || order.status == "pending_payment" %>
    <!-- Pending STK Push State: Focused & Minimal -->
    <div class="p-5 rounded-xl bg-[#FAF6EE] border border-[#D48B38]/30 space-y-3">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-full bg-[#00A859] text-white flex items-center justify-center font-bold text-sm">
          📱
        </div>
        <div>
          <h2 class="font-serif text-base font-bold text-[#140B07]">Awaiting M-Pesa PIN on Phone</h2>
          <p class="text-xs text-neutral-500">Sent to: <strong class="text-[#00A859]"><%= order.customer_phone %></strong></p>
        </div>
      </div>

      <div class="bg-white p-3 rounded-lg border border-[#EFE7DA] text-xs text-neutral-600 flex items-center justify-between">
        <span>Amount Due: <strong class="text-[#140B07]"><%= CurrencyHelper.format_money(order.total_kes, "KES") %></strong></span>
        <span>Fallback Paybill: <strong class="text-[#00A859]">174379</strong> (Acc: <%= order.order_number %>)</span>
      </div>

      <!-- Retry STK Push Form -->
      <div class="pt-1">
        <%= form_with url: retry_stk_order_path(order), method: :post, local: true, class: "flex items-center space-x-2" do |f| %>
          <%= f.telephone_field :phone_number, value: order.customer_phone, class: "text-xs p-2 rounded-lg border border-[#EFE7DA] bg-white text-neutral-800 focus:outline-none focus:ring-2 focus:ring-[#00A859] w-44" %>
          <%= f.submit "Resend M-Pesa Prompt", class: "px-3.5 py-2 rounded-lg bg-[#00A859] hover:bg-[#008F4C] text-white text-xs font-semibold cursor-pointer shadow-xs transition-all" %>
        <% end %>
      </div>
    </div>

  <% else %>
    <!-- Failed or Cancelled State -->
    <div class="p-5 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 space-y-2">
      <h2 class="font-serif text-base font-bold text-rose-800">Transaction Not Completed</h2>
      <p class="text-xs text-rose-700">The M-Pesa request timed out or was cancelled.</p>
      <div class="pt-1">
        <%= form_with url: retry_stk_order_path(order), method: :post, local: true do |f| %>
          <%= f.hidden_field :phone_number, value: order.customer_phone %>
          <%= f.submit "Retry M-Pesa Payment", class: "px-3.5 py-2 bg-[#00A859] text-white rounded-lg text-xs font-semibold cursor-pointer" %>
        <% end %>
      </div>
    </div>
  <% end %>

</div>

<div id="order_status_section" class="bg-white p-5 sm:p-6 rounded-2xl border border-[#EFE7DA] shadow-xs space-y-4">
  
  <% if order.paid? %>
    <!-- Paid Success Banner -->
    <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 space-y-2">
      <div>
        <h2 class="font-serif text-base font-bold text-[#006C38]">Payment Confirmed</h2>
        <p class="text-xs text-emerald-700">Receipt: <strong><%= order.mpesa_transaction&.mpesa_receipt_number.presence || order.order_number %></strong></p>
      </div>
      <p class="text-xs text-emerald-800">
        Amount paid: <strong><%= CurrencyHelper.format_money(order.total_kes, "KES") %></strong>.
      </p>

      <div class="pt-1 flex flex-wrap gap-2">
        <%= link_to "Track Delivery", track_order_path(order), class: "px-3.5 py-1.5 rounded-lg bg-[#00A859] hover:bg-[#008F4C] text-white text-xs font-semibold shadow-xs transition-all" %>
        <%= link_to "Continue Shopping", products_path, class: "px-3.5 py-1.5 rounded-lg bg-white border border-emerald-300 text-emerald-800 text-xs font-medium hover:bg-emerald-100 transition-colors" %>
      </div>
    </div>

  <% elsif order.status == "payment_processing" || order.status == "pending_payment" %>
    <!-- Pending State -->
    <div class="p-4 rounded-xl bg-[#FAF6EE] border border-[#D48B38]/30 space-y-2.5">
      <div>
        <h2 class="font-serif text-sm font-bold text-[#140B07]">Awaiting Payment Authorization</h2>
        <p class="text-xs text-neutral-500">Phone: <strong class="text-[#140B07]"><%= order.customer_phone %></strong></p>
      </div>

      <div class="bg-white p-2.5 rounded-lg border border-[#EFE7DA] text-xs text-neutral-700">
        Amount Due: <strong class="text-[#140B07]"><%= CurrencyHelper.format_money(order.total_kes, "KES") %></strong>
      </div>

      <!-- Retry Form -->
      <div class="pt-1">
        <%= form_with url: retry_stk_order_path(order), method: :post, local: true, class: "flex items-center space-x-2" do |f| %>
          <%= f.telephone_field :phone_number, value: order.customer_phone, class: "text-xs p-2 rounded-lg border border-[#EFE7DA] bg-white text-neutral-800 focus:outline-none focus:ring-1 focus:ring-[#00A859] w-44" %>
          <%= f.submit "Resend Prompt", class: "px-3.5 py-2 rounded-lg bg-[#00A859] hover:bg-[#008F4C] text-white text-xs font-semibold cursor-pointer shadow-xs transition-all" %>
        <% end %>
      </div>
    </div>

  <% else %>
    <!-- Failed State -->
    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 space-y-2">
      <h2 class="font-serif text-sm font-bold text-rose-800">Transaction Not Completed</h2>
      <p class="text-xs text-rose-700">The payment request timed out or was cancelled.</p>
      <div class="pt-1">
        <%= form_with url: retry_stk_order_path(order), method: :post, local: true do |f| %>
          <%= f.hidden_field :phone_number, value: order.customer_phone %>
          <%= f.submit "Retry Payment", class: "px-3.5 py-2 bg-[#00A859] text-white rounded-lg text-xs font-semibold cursor-pointer" %>
        <% end %>
      </div>
    </div>
  <% end %>

</div>

<div class="py-12 bg-[#FAF6EE]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <div class="border-b border-[#EFE7DA] pb-6 flex items-center justify-between">
      <div>
        <span class="text-xs font-bold text-[#9E472A] uppercase tracking-widest">Shopping Basket</span>
        <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[#140B07]">Your Buna Ceremony Basket</h1>
      </div>
      <%= link_to "Continue Shopping", products_path, class: "text-xs font-bold text-[#D48B38] hover:underline" %>
    </div>

    <% if @cart_items.empty? %>
      <div class="bg-white p-12 rounded-3xl border border-[#EFE7DA] text-center space-y-4 shadow-sm">
        <div class="w-16 h-16 mx-auto rounded-full bg-[#FAF6EE] flex items-center justify-center text-3xl">☕</div>
        <h2 class="font-serif text-2xl font-bold text-[#140B07]">Your basket is currently empty</h2>
        <p class="text-xs text-neutral-600 max-w-sm mx-auto">Discover fresh Ethiopian highland roasts, handcrafted clay Jebenas, and ceremony accessories.</p>
        <div class="pt-4">
          <%= link_to "Explore Coffee Varieties", products_path(category: "coffee-varieties"), class: "inline-flex px-6 py-3 rounded-xl bg-[#24130D] text-[#E5A652] font-semibold text-xs hover:bg-[#140B07]" %>
        </div>
      </div>
    <% else %>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Cart Items List -->
        <div class="lg:col-span-8 bg-white p-6 sm:p-8 rounded-3xl border border-[#EFE7DA] shadow-sm divide-y divide-[#EFE7DA]">
          <% @cart_items.each do |item| %>
            <div class="py-4 first:pt-0 last:pb-0 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div class="flex-1">
                <span class="text-[10px] text-[#9E472A] font-bold uppercase"><%= item[:product].category.name %></span>
                <h3 class="font-serif font-bold text-base text-[#140B07]">
                  <%= link_to item[:product].name, product_path(item[:product]), class: "hover:text-[#9E472A]" %>
                </h3>
                <div class="text-xs text-neutral-500 mt-1 flex flex-wrap gap-2">
                  <% if item[:format].present? %><span class="bg-[#FAF6EE] px-2 py-0.5 rounded text-[11px]"><%= item[:format] %></span><% end %>
                  <% if item[:roast].present? %><span class="bg-[#24130D] text-[#E5A652] px-2 py-0.5 rounded text-[11px]"><%= item[:roast] %></span><% end %>
                </div>
              </div>

              <!-- Price & Quantity -->
              <div class="flex items-center space-x-6">
                <div class="text-right">
                  <span class="text-xs text-neutral-400 block">Unit: <%= item[:product].formatted_price(current_currency) %></span>
                  <span class="font-bold text-base text-[#9E472A]">
                    <%= CurrencyHelper.format_money(current_currency == 'ETB' ? item[:total_etb] : item[:total_kes], current_currency) %>
                  </span>
                </div>

                <div class="flex items-center space-x-3">
                  <div class="flex items-center space-x-1.5 bg-[#FAF6EE] p-1 rounded-xl border border-[#EFE7DA]">
                    <%= button_to cart_update_path(product_id: item[:product].id, quantity: item[:quantity] - 1), method: :patch, class: "w-6 h-6 rounded-lg bg-white hover:bg-[#EFE7DA] text-[#24130D] font-bold text-xs flex items-center justify-center shadow-xs transition-colors cursor-pointer" do %>
                      −
                    <% end %>
                    <span class="px-2 text-xs font-bold text-[#140B07] min-w-[20px] text-center"><%= item[:quantity] %></span>
                    <%= button_to cart_update_path(product_id: item[:product].id, quantity: item[:quantity] + 1), method: :patch, class: "w-6 h-6 rounded-lg bg-[#24130D] hover:bg-[#140B07] text-[#E5A652] font-bold text-xs flex items-center justify-center shadow-xs transition-colors cursor-pointer" do %>
                      +
                    <% end %>
                  </div>
                  <%= button_to cart_remove_path(product_id: item[:product].id), method: :delete, title: "Remove item", class: "p-2 text-neutral-400 hover:text-red-600 rounded-lg hover:bg-neutral-100 transition-colors cursor-pointer" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <div class="pt-6 flex justify-between items-center text-xs">
            <%= button_to "Clear Basket", cart_clear_path, method: :delete, class: "text-neutral-500 hover:text-red-600 underline" %>
            <%= link_to "← Continue Shopping", products_path, class: "font-semibold text-[#D48B38] hover:text-[#9E472A]" %>
          </div>
        </div>

        <!-- Summary & Checkout Action -->
        <div class="lg:col-span-4 bg-white p-6 sm:p-8 rounded-3xl border border-[#EFE7DA] shadow-sm space-y-6">
          <h2 class="font-serif text-xl font-bold text-[#140B07] border-b border-[#EFE7DA] pb-4">Order Summary</h2>

          <div class="space-y-3 text-xs">
            <div class="flex justify-between text-neutral-600">
              <span>Items Total:</span>
              <span class="font-bold text-[#140B07]">
                <%= format_currency(cart_subtotal, current_currency) %>
              </span>
            </div>
            <div class="flex justify-between text-neutral-500 text-[11px]">
              <span>Moyale Border Customs:</span>
              <span class="text-[#00A859] font-medium">Included</span>
            </div>
            <p class="text-[11px] text-neutral-400 pt-1">Kenyan courier delivery calculated at checkout.</p>
          </div>

          <div class="pt-4 border-t border-[#EFE7DA]">
            <%= link_to new_checkout_path, class: "w-full py-4 px-6 rounded-2xl bg-[#00A859] hover:bg-[#008F4C] text-white font-bold text-center block shadow-lg hover:shadow-xl transition-all" do %>
              Proceed to M-Pesa Checkout →
            <% end %>
          </div>
        </div>

      </div>
    <% end %>

  </div>
</div>

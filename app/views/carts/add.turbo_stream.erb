<%= turbo_stream.update "cart-counter-badge" do %>
  <%= cart_count %>
<% end %>

<%= turbo_stream.update "drawer-item-count" do %>
  <%= cart_count %>
<% end %>

<%= turbo_stream.update "cart-drawer-content" do %>
  <%= render "carts/cart_drawer" %>
<% end %>

<%= turbo_stream.append "cart-drawer-content" do %>
  <script>
    document.dispatchEvent(new CustomEvent("cart:open"));
  </script>
<% end %>

<% free_shipping_threshold = current_currency == 'ETB' ? 3080 : 3500 %>
<% current_total = cart_subtotal.to_f %>
<% progress_pct = [ (current_total / free_shipping_threshold * 100).round, 100 ].min %>

<% if current_cart.empty? %>
  <!-- Clean Minimal Empty State -->
  <div class="flex-1 flex flex-col items-center justify-center p-8 text-center space-y-4">
    <div class="space-y-1">
      <h4 class="font-serif text-lg font-bold text-[#140B07]">Your Basket is Empty</h4>
    </div>
    <div class="pt-2">
      <%= link_to "Explore Catalog", products_path, data: { action: "click->cart#close" }, class: "py-2 px-5 rounded-xl bg-[#24130D] text-[#E5A652] hover:bg-[#140B07] text-xs font-bold inline-block shadow-xs transition-all" %>
    </div>
  </div>

<% else %>

  <!-- Delivery Progress Bar -->
  <div class="px-5 py-2.5 bg-white border-b border-[#EFE7DA]">
    <div class="flex items-center justify-between text-[11px] mb-1.5">
      <span class="text-neutral-600">
        <% if current_total >= free_shipping_threshold %>
          <span class="text-[#00A859] font-bold">Free Delivery Unlocked</span>
        <% else %>
          Add <strong class="text-[#9E472A]"><%= format_currency(free_shipping_threshold - current_total, current_currency) %></strong> for free delivery
        <% end %>
      </span>
      <span class="font-mono text-neutral-400 text-[10px]"><%= progress_pct %>%</span>
    </div>
    <div class="w-full bg-[#EFE7DA] h-1.5 rounded-full overflow-hidden">
      <div class="bg-[#00A859] h-full rounded-full transition-all duration-300" style="width: <%= progress_pct %>%"></div>
    </div>
  </div>

  <!-- Cart Line Items -->
  <div class="flex-1 overflow-y-auto px-5 py-3 space-y-2.5">
    <% current_cart.each do |product_id, item| %>
      <% product = Product.find_by(id: product_id) %>
      <% next unless product %>
      <% qty = item["quantity"].to_i %>
      <% line_total_kes = product.price_kes * qty %>
      <% line_total_etb = product.price_etb * qty %>
      <% line_total = current_currency == "ETB" ? line_total_etb : line_total_kes %>

      <div class="p-3 rounded-xl bg-white border border-[#EFE7DA] shadow-xs space-y-2.5">
        <div class="flex items-start gap-3">
          <div class="w-12 h-12 rounded-lg overflow-hidden bg-[#FAF6EE] border border-[#EFE7DA] shrink-0">
            <img src="<%= product.display_image_url %>" alt="<%= product.name %>" class="w-full h-full object-cover">
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-1">
              <h5 class="text-xs font-serif font-bold text-[#140B07] hover:text-[#9E472A] truncate">
                <%= link_to product.name, product_path(product), data: { action: "click->cart#close" } %>
              </h5>
              <%= button_to "✕", cart_remove_path(product_id: product.id), method: :delete, title: "Remove item", class: "p-0.5 text-neutral-400 hover:text-red-600 rounded text-xs transition-colors cursor-pointer" %>
            </div>
            <% if item["format"].present? || item["roast"].present? %>
              <div class="text-[10px] text-neutral-500 mt-0.5 truncate">
                <%= [item["format"], item["roast"]].compact.join(" • ") %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="pt-1.5 border-t border-[#FAF6EE] flex items-center justify-between">
          <!-- Quantity Stepper Controls -->
          <div class="flex items-center space-x-1 bg-[#FAF6EE] p-0.5 rounded-lg border border-[#EFE7DA]">
            <%= button_to cart_update_path(product_id: product.id, quantity: qty - 1), method: :patch, class: "w-5 h-5 rounded bg-white hover:bg-[#EFE7DA] text-[#24130D] font-bold text-xs flex items-center justify-center transition-colors cursor-pointer" do %>
              −
            <% end %>
            <span class="px-1.5 text-xs font-bold text-[#140B07] min-w-[16px] text-center"><%= qty %></span>
            <%= button_to cart_update_path(product_id: product.id, quantity: qty + 1), method: :patch, class: "w-5 h-5 rounded bg-[#24130D] hover:bg-[#140B07] text-[#E5A652] font-bold text-xs flex items-center justify-center transition-colors cursor-pointer" do %>
              +
            <% end %>
          </div>

          <div class="text-right">
            <span class="text-xs font-bold text-[#9E472A]">
              <%= CurrencyHelper.format_money(line_total, current_currency) %>
            </span>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Drawer Footer -->
  <div class="p-5 bg-white border-t border-[#EFE7DA] space-y-3 shadow-xl">
    <div class="flex justify-between items-baseline">
      <span class="text-xs font-semibold text-neutral-700">Subtotal</span>
      <span class="font-serif font-bold text-xl text-[#140B07]">
        <%= format_currency(cart_subtotal, current_currency) %>
      </span>
    </div>

    <!-- Primary Action: Checkout -->
    <%= link_to "Checkout", new_checkout_path, data: { action: "click->cart#close" }, class: "w-full py-3 px-4 rounded-xl bg-[#00A859] hover:bg-[#008F4C] text-white font-bold text-xs text-center block shadow-sm hover:shadow transition-all cursor-pointer" %>

    <!-- Secondary Links -->
    <div class="flex items-center justify-between text-[11px] pt-1">
      <%= link_to "View Basket Page", cart_path, data: { action: "click->cart#close" }, class: "text-[#D48B38] hover:text-[#9E472A] underline" %>
      <%= button_to "Clear Basket", cart_clear_path, method: :delete, data: { turbo_confirm: "Empty your basket?" }, class: "text-neutral-400 hover:text-red-600 transition-colors cursor-pointer" %>
    </div>
  </div>

<% end %>

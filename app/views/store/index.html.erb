<!-- HERO SECTION -->
<section class="relative bg-[#24130D] text-white overflow-hidden py-16 sm:py-24 border-b border-[#3A2016]">
  <!-- Background Pattern Accent -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#D48B38_1px,transparent_1px)] [background-size:16px_16px]"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-[#3A2016] text-[#E5A652] text-xs font-semibold border border-[#9E472A]/40">
          <span class="w-2 h-2 rounded-full bg-[#00A859]"></span>
          <span>Kenyan Connoisseur Direct Sourcing • Moyale Corridor</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#FAF6EE] leading-tight">
          The Sacred Buna Ceremony, <br>
          <span class="text-[#D48B38] italic font-normal">Direct from Ethiopia to Kenya.</span>
        </h1>

        <p class="text-sm sm:text-base text-neutral-300 max-w-2xl leading-relaxed">
          Experience authentic Ethiopian coffee culture in Nairobi. Sourced directly from heirloom wild forests in <span class="text-[#E5A652] font-semibold">Yirgacheffe, Sidamo, Harrar, Limu, and Kaffa</span>. Accompanied by authentic clay <strong class="text-white">Jebenas (ጀበና)</strong>, hand-turned <strong class="text-white">Rekebot tables</strong>, fragrant <strong class="text-white">Tigray Frankincense</strong>, and ceremonial <strong class="text-white">Tenadam herbs</strong>.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 pt-2">
          <%= link_to products_path(category: "coffee-varieties"), class: "px-6 py-3.5 rounded-xl bg-[#D48B38] text-[#140B07] font-bold text-sm hover:bg-[#E5A652] shadow-lg transition-all flex items-center space-x-2" do %>
            <span>Shop Single-Origin Beans</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          <% end %>

          <%= link_to products_path(category: "traditional-brewing-hardware"), class: "px-6 py-3.5 rounded-xl bg-[#3A2016] text-[#FAF6EE] font-semibold text-sm hover:bg-[#140B07] border border-[#9E472A]/50 transition-all" do %>
            Clay Jebenas & Serving Ware
          <% end %>
        </div>

        <!-- Regional Trust Indicators -->
        <div class="pt-6 border-t border-[#3A2016]/80 grid grid-cols-3 gap-4 text-xs">
          <div>
            <div class="text-[#00A859] font-bold">Safaricom M-Pesa</div>
            <div class="text-neutral-400 text-[11px]">Instant STK Push Checkout</div>
          </div>
          <div>
            <div class="text-[#E5A652] font-bold">Moyale OSBP Customs</div>
            <div class="text-neutral-400 text-[11px]">Direct cross-border transit</div>
          </div>
          <div>
            <div class="text-[#FAF6EE] font-bold">Addis Ababa Roasted</div>
            <div class="text-neutral-400 text-[11px]">Small-batch artisan freshness</div>
          </div>
        </div>
      </div>

      <!-- Hero Visual Representation -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md bg-gradient-to-b from-[#3A2016] to-[#140B07] p-8 rounded-2xl border border-[#9E472A]/30 shadow-2xl">
          <div class="text-center space-y-4">
            <div class="w-24 h-24 mx-auto rounded-full bg-[#9E472A]/20 flex items-center justify-center border-2 border-[#D48B38]/40">
              <span class="font-serif text-3xl font-bold text-[#E5A652]">ጀበና</span>
            </div>
            
            <h3 class="font-serif text-2xl font-bold text-[#FAF6EE]">The Complete Buna Set</h3>
            <p class="text-xs text-neutral-300 leading-relaxed">
              Clay Jebena pot from Gondar, Menkeshkesh roasting pan, Sini porcelain cups, Rekebot tray, and Tigray Frankincense burner.
            </p>

            <div class="pt-4 flex items-center justify-between border-t border-[#3A2016] text-xs">
              <span class="text-neutral-400">Merchant Contact:</span>
              <span class="font-bold text-[#00A859]">+254707172370</span>
            </div>

            <div class="pt-2">
              <%= link_to "View All Ceremony Hardware", products_path(category: "traditional-brewing-hardware"), class: "block w-full py-2.5 rounded-lg bg-[#9E472A] hover:bg-[#B55A3C] text-white text-xs font-semibold transition-all shadow" %>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- THE 3 SACRED ROUNDS OF BUNA CEREMONY -->
<section class="py-16 bg-[#FAF6EE] border-b border-[#EFE7DA]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-12">
      <span class="text-xs font-bold text-[#9E472A] uppercase tracking-widest">The Ritual Experience</span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#140B07]">The Three Rounds of Buna</h2>
      <p class="text-sm text-neutral-600">
        In Ethiopian heritage, the Buna ceremony is never rushed. It represents communion, blessing, and peace, unfolded across three ceremonial servings:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Round 1: Abol -->
      <div class="p-8 rounded-2xl bg-white border border-[#EFE7DA] shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
        <div class="text-4xl font-serif font-black text-[#D48B38]/30 absolute top-4 right-4">01</div>
        <div class="text-xs font-bold text-[#9E472A] uppercase tracking-wider">Round One</div>
        <h3 class="font-serif text-2xl font-bold text-[#140B07] mt-1">Abol (አቦል)</h3>
        <p class="text-xs font-semibold text-[#D48B38] mt-1">The Pure First Extraction</p>
        <p class="text-xs text-neutral-600 mt-3 leading-relaxed">
          The deepest, most robust and concentrated cup poured from the top of the Jebena. Served to elders and honored guests first as a sign of supreme respect.
        </p>
      </div>

      <!-- Round 2: Tona -->
      <div class="p-8 rounded-2xl bg-white border border-[#EFE7DA] shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
        <div class="text-4xl font-serif font-black text-[#D48B38]/30 absolute top-4 right-4">02</div>
        <div class="text-xs font-bold text-[#9E472A] uppercase tracking-wider">Round Two</div>
        <h3 class="font-serif text-2xl font-bold text-[#140B07] mt-1">Tona (ቶና)</h3>
        <p class="text-xs font-semibold text-[#D48B38] mt-1">The Round of Kinship</p>
        <p class="text-xs text-neutral-600 mt-3 leading-relaxed">
          Water is added to the grounds remaining in the clay Jebena and gently brought back to a rolling simmer. This cup is smoother and sweet, fostering intimate dialogue.
        </p>
      </div>

      <!-- Round 3: Baraka -->
      <div class="p-8 rounded-2xl bg-white border border-[#EFE7DA] shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
        <div class="text-4xl font-serif font-black text-[#D48B38]/30 absolute top-4 right-4">03</div>
        <div class="text-xs font-bold text-[#9E472A] uppercase tracking-wider">Round Three</div>
        <h3 class="font-serif text-2xl font-bold text-[#140B07] mt-1">Baraka (በረካ)</h3>
        <p class="text-xs font-semibold text-[#D48B38] mt-1">The Final Blessing</p>
        <p class="text-xs text-neutral-600 mt-3 leading-relaxed">
          The third and gentle brew, symbolizing the impartation of spiritual blessing and peace upon the household. It is customary never to leave before Baraka is served.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- COFFEE ZONES NAVIGATOR -->
<section class="py-16 bg-[#EFE7DA]/50 border-b border-[#EFE7DA]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <span class="text-xs font-bold text-[#9E472A] uppercase tracking-widest">Heirloom Terroirs</span>
        <h2 class="font-serif text-3xl font-bold text-[#140B07]">Explore by Origin Zone</h2>
      </div>
      <%= link_to "View All Coffees & Formats →", products_path(category: "coffee-varieties"), class: "text-xs font-bold text-[#D48B38] hover:text-[#9E472A]" %>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      <% @coffee_zones.each do |zone| %>
        <%= link_to products_path(zone: zone), class: "p-5 rounded-xl bg-white border border-[#EFE7DA] hover:border-[#D48B38] hover:shadow-md transition-all group text-center" do %>
          <div class="w-10 h-10 mx-auto rounded-full bg-[#24130D] text-[#E5A652] flex items-center justify-center font-bold text-sm mb-2 group-hover:scale-110 transition-transform">
            <%= zone[0..1] %>
          </div>
          <div class="font-serif font-bold text-[#140B07] text-base group-hover:text-[#9E472A]"><%= zone %></div>
          <div class="text-[11px] text-neutral-500 mt-1">Heirloom Varietals</div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<!-- FEATURED PRODUCTS SHOWCASE -->
<section class="py-20 bg-[#FAF6EE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14 space-y-2">
      <span class="text-xs font-bold text-[#9E472A] uppercase tracking-widest">Curated Offerings</span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#140B07]">Featured Coffee & Artifacts</h2>
      <p class="text-xs text-neutral-600">Available in Raw Green Beans, Roasted Whole Beans, and Fresh Fine Ground for Jebena brewing.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <% @all_featured.each do |product| %>
        <div class="bg-white rounded-2xl border border-[#EFE7DA] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
          
          <!-- Product Card Header / Badge -->
          <div class="p-6 bg-gradient-to-br from-[#FAF6EE] to-[#EFE7DA]/50 flex items-center justify-between border-b border-[#EFE7DA]">
            <span class="px-2.5 py-1 rounded-full bg-white text-[#9E472A] text-[11px] font-bold border border-[#EFE7DA] shadow-xs">
              <%= product.origin_zone.presence || product.category.name %>
            </span>
            <% if product.roast_profile.present? %>
              <span class="px-2 py-0.5 rounded bg-[#24130D] text-[#E5A652] text-[10px] font-semibold">
                <%= product.roast_profile %>
              </span>
            <% end %>
          </div>

          <!-- Product Details Body -->
          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <div class="text-[11px] text-[#D48B38] font-amharic font-semibold"><%= product.amharic_name %></div>
              <h3 class="font-serif text-lg font-bold text-[#140B07] group-hover:text-[#9E472A] transition-colors mt-0.5">
                <%= link_to product.name, product_path(product) %>
              </h3>
              <p class="text-xs text-neutral-600 mt-2 line-clamp-2 leading-relaxed">
                <%= product.short_description.presence || product.description %>
              </p>
            </div>

            <!-- Coffee Specific Sensory Tags -->
            <% if product.tasting_notes.present? %>
              <div class="pt-2 flex flex-wrap gap-1">
                <% product.tasting_notes_array.first(3).each do |note| %>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#FAF6EE] text-[#3A2016] border border-[#EFE7DA]">
                    <%= note %>
                  </span>
                <% end %>
              </div>
            <% end %>

            <!-- Price & Add Action -->
            <div class="pt-4 border-t border-[#EFE7DA] flex items-center justify-between">
              <div>
                <span class="text-[10px] text-neutral-500 uppercase block">Price (<%= current_currency %>)</span>
                <span class="font-bold text-lg text-[#140B07]"><%= product.formatted_price(current_currency) %></span>
              </div>

              <%= button_to cart_add_path(product_id: product.id, quantity: 1, format_selected: product.bean_format.presence || "Whole Beans"), method: :post, class: "p-2.5 rounded-xl bg-[#24130D] text-[#E5A652] hover:bg-[#00A859] hover:text-white transition-all shadow-sm" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              <% end %>
            </div>

          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- REGIONAL CHECKOUT & SAFARICOM M-PESA ASSURANCE -->

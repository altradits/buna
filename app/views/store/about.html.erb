<div class="py-12 bg-[#FAF6EE]">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <div class="text-center space-y-2">
      <span class="text-xs font-bold text-[#9E472A] uppercase tracking-widest">Heritage & Culture</span>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[#140B07]">The Ethiopian Buna Ceremony</h1>
      <p class="text-xs sm:text-sm text-neutral-500 max-w-lg mx-auto">
        A guide to brewing authentic coffee using the clay Jebena, fragrant Frankincense, and Ketema grass.
      </p>
    </div>

    <!-- Step by Step Ritual Guide: Clean & Minimal -->
    <div class="space-y-6 bg-white p-6 sm:p-8 rounded-2xl border border-[#EFE7DA] shadow-xs">
      
      <!-- Step 1 -->
      <div class="flex items-start space-x-4 border-b border-[#FAF6EE] pb-6">
        <div class="w-8 h-8 rounded-lg bg-[#24130D] text-[#E5A652] font-serif font-bold text-sm flex items-center justify-center flex-shrink-0">1</div>
        <div class="space-y-1">
          <h3 class="font-serif text-base font-bold text-[#140B07]">Preparing the Spatial Sanctuary</h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            The floor is strewn with fresh green grass or braided <strong>Ketema mats (ቄጠማ)</strong>. A runner is draped across the <strong>Rekebot serving table</strong>, and <strong>Tigray Frankincense (ዕጣን)</strong> is cast onto charcoal to perfume the room.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="flex items-start space-x-4 border-b border-[#FAF6EE] pb-6">
        <div class="w-8 h-8 rounded-lg bg-[#24130D] text-[#E5A652] font-serif font-bold text-sm flex items-center justify-center flex-shrink-0">2</div>
        <div class="space-y-1">
          <h3 class="font-serif text-base font-bold text-[#140B07]">Roasting in the Menkeshkesh (መንከሽከሽ)</h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            Raw green beans are washed, then roasted over hot coals in the perforated iron <strong>Menkeshkesh</strong>. When aromatic smoke rises, guests cup the smoke with their hands to inhale the fragrant bounty.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="flex items-start space-x-4 border-b border-[#FAF6EE] pb-6">
        <div class="w-8 h-8 rounded-lg bg-[#24130D] text-[#E5A652] font-serif font-bold text-sm flex items-center justify-center flex-shrink-0">3</div>
        <div class="space-y-1">
          <h3 class="font-serif text-base font-bold text-[#140B07]">Pounding & Fine Milling</h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            The roasted beans are ground finely using a heavy wooden mortar (Mukecha and Zenezena) or precision fine mill to allow complete emulsion in hot water.
          </p>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="flex items-start space-x-4">
        <div class="w-8 h-8 rounded-lg bg-[#24130D] text-[#E5A652] font-serif font-bold text-sm flex items-center justify-center flex-shrink-0">4</div>
        <div class="space-y-1">
          <h3 class="font-serif text-base font-bold text-[#140B07]">Brewing in the Clay Jebena (ጀበና)</h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            Coffee grounds and fresh water are simmered in the clay Jebena. Poured in a continuous arch into small <strong>Sini cups (ሲኒ)</strong>, served alongside roasted barley (Kolo) and fresh rue (Tenadam).
          </p>
        </div>
      </div>

    </div>

    <!-- Clean CTA -->
    <div class="bg-[#24130D] text-white p-6 rounded-2xl border border-[#9E472A]/40 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1 text-center sm:text-left">
        <h3 class="font-serif text-lg font-bold text-[#E5A652]">Bringing the Tradition to Kenya</h3>
        <p class="text-xs text-neutral-300">
          Direct cross-border sourcing cleared through Moyale OSBP.
        </p>
      </div>
      <%= link_to "Explore Products", products_path, class: "px-5 py-2.5 rounded-xl bg-[#00A859] hover:bg-[#008F4C] text-white font-semibold text-xs transition-all whitespace-nowrap shadow-xs" %>
    </div>

  </div>
</div>

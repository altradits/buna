<div class="py-12 bg-[#FAF6EE]" 
     data-controller="checkout" 
     data-checkout-subtotal-kes-value="<%= @subtotal_kes %>" 
     data-checkout-subtotal-etb-value="<%= @subtotal_etb %>" 
     data-checkout-rate-kes-to-etb-value="<%= CurrencyHelper.current_rate_kes_to_etb %>">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <!-- Title & Back to Basket Header -->
    <div class="border-b border-[#EFE7DA] pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-[#140B07]">Checkout</h1>
      </div>
      <div>
        <%= link_to "Back to Basket", cart_path, class: "inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-lg bg-white border border-[#EFE7DA] text-[#24130D] hover:bg-[#FAF6EE] transition-colors" %>
      </div>
    </div>

    <%= form_with url: checkout_path, method: :post, local: true, data: { action: "submit->checkout#handleSubmit" }, class: "grid grid-cols-1 lg:grid-cols-12 gap-8 items-start" do |f| %>
      
      <!-- Left Column: Shipping & Customer Details -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Recipient Information -->
        <div class="bg-white p-5 sm:p-6 rounded-2xl border border-[#EFE7DA] shadow-xs space-y-4">
          <div class="flex items-center space-x-2.5 border-b border-[#EFE7DA] pb-3">
            <span class="w-6 h-6 rounded-full bg-[#24130D] text-[#E5A652] flex items-center justify-center font-bold text-xs">1</span>
            <h2 class="font-serif text-base font-bold text-[#140B07]">Customer & Recipient Details</h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-1">Full Name</label>
              <%= f.text_field :customer_name, value: (current_user&.full_name || "Buna Connoisseur"), required: true, class: "w-full text-xs p-2.5 rounded-xl border border-[#EFE7DA] bg-[#FAF6EE]/50 focus:ring-2 focus:ring-[#D48B38] focus:bg-white focus:outline-none" %>
            </div>

            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-1">Email Address</label>
              <%= f.email_field :customer_email, value: (current_user&.email || "yebente@gmail.com"), required: true, class: "w-full text-xs p-2.5 rounded-xl border border-[#EFE7DA] bg-[#FAF6EE]/50 focus:ring-2 focus:ring-[#D48B38] focus:bg-white focus:outline-none" %>
            </div>
          </div>
        </div>

        <!-- Kenyan Delivery Location & Live Shipping Calculator -->
        <div class="bg-white p-5 sm:p-6 rounded-2xl border border-[#EFE7DA] shadow-xs space-y-4">
          <div class="flex items-center space-x-2.5 border-b border-[#EFE7DA] pb-3">
            <span class="w-6 h-6 rounded-full bg-[#24130D] text-[#E5A652] flex items-center justify-center font-bold text-xs">2</span>
            <h2 class="font-serif text-base font-bold text-[#140B07]">Delivery Destination & Courier</h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-1">Destination County</label>
              <%= f.select :delivery_county, options_for_select(@counties, @selected_county), {}, data: { checkout_target: "countySelect", action: "change->checkout#updateCalculations" }, class: "w-full text-xs p-2.5 rounded-xl border border-[#EFE7DA] bg-white focus:ring-2 focus:ring-[#D48B38] focus:outline-none cursor-pointer" %>
            </div>

            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-1">City / Neighborhood</label>
              <%= f.text_field :delivery_city, value: "Nairobi", required: true, class: "w-full text-xs p-2.5 rounded-xl border border-[#EFE7DA] bg-[#FAF6EE]/50 focus:ring-2 focus:ring-[#D48B38] focus:bg-white focus:outline-none" %>
            </div>

            <div class="sm:col-span-2">
              <label class="block text-xs font-semibold text-neutral-700 mb-1">Street Address</label>
              <%= f.text_area :delivery_address, rows: 2, placeholder: "e.g. House 14, Acacia Avenue, Nairobi", required: true, class: "w-full text-xs p-2.5 rounded-xl border border-[#EFE7DA] bg-[#FAF6EE]/50 focus:ring-2 focus:ring-[#D48B38] focus:bg-white focus:outline-none" %>
            </div>
          </div>

          <!-- Compact Courier Selector -->
          <div class="pt-3 border-t border-[#EFE7DA] space-y-2">
            <label class="block text-xs font-semibold text-neutral-700">Courier Partner</label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
              <label class="p-2.5 rounded-xl border border-[#D48B38] bg-[#FAF6EE] flex items-center justify-between cursor-pointer text-xs hover:border-[#D48B38] transition-all">
                <div class="flex items-center space-x-2">
                  <%= f.radio_button :courier_provider, "Fargo Courier East Africa", checked: (@selected_courier == "Fargo Courier East Africa"), data: { checkout_target: "courierRadio", action: "change->checkout#updateCalculations" }, class: "text-[#D48B38] focus:ring-[#D48B38]" %>
                  <div>
                    <span class="font-bold text-[#140B07] block text-xs">Fargo Courier</span>
                    <span class="text-[10px] text-neutral-500">Standard • 3-4 Days</span>
                  </div>
                </div>
              </label>

              <label class="p-2.5 rounded-xl border border-[#EFE7DA] bg-white flex items-center justify-between cursor-pointer text-xs hover:border-[#D48B38] transition-all">
                <div class="flex items-center space-x-2">
                  <%= f.radio_button :courier_provider, "Sendy Express Kenya", checked: (@selected_courier == "Sendy Express Kenya"), data: { checkout_target: "courierRadio", action: "change->checkout#updateCalculations" }, class: "text-[#D48B38] focus:ring-[#D48B38]" %>
                  <div>
                    <span class="font-bold text-[#140B07] block text-xs">Sendy Express</span>
                    <span class="text-[10px] text-[#D48B38]">+KSh 150 • 2-3 Days</span>
                  </div>
                </div>
              </label>

              <label class="p-2.5 rounded-xl border border-[#EFE7DA] bg-white flex items-center justify-between cursor-pointer text-xs hover:border-[#D48B38] transition-all">
                <div class="flex items-center space-x-2">
                  <%= f.radio_button :courier_provider, "DHL East Africa", checked: (@selected_courier == "DHL East Africa"), data: { checkout_target: "courierRadio", action: "change->checkout#updateCalculations" }, class: "text-[#D48B38] focus:ring-[#D48B38]" %>
                  <div>
                    <span class="font-bold text-[#140B07] block text-xs">DHL East Africa</span>
                    <span class="text-[10px] text-[#9E472A]">+KSh 450 • 1-2 Days</span>
                  </div>
                </div>
              </label>
            </div>
          </div>
        </div>

        <!-- Payment Details -->
        <div class="bg-white p-5 sm:p-6 rounded-2xl border border-[#EFE7DA] shadow-xs space-y-4">
          <div class="flex items-center space-x-2.5 border-b border-[#EFE7DA] pb-3">
            <span class="w-6 h-6 rounded-full bg-[#00A859] text-white flex items-center justify-center font-bold text-xs">3</span>
            <div class="flex-1 flex items-center justify-between">
              <h2 class="font-serif text-base font-bold text-[#140B07]">Payment</h2>
            </div>
          </div>

          <div class="space-y-2">
            <label class="block text-xs font-semibold text-neutral-700">
              Mobile Number
            </label>
            <div>
              <%= f.telephone_field :customer_phone, value: @default_phone, placeholder: "0707 172 370", required: true, data: { checkout_target: "phoneInput", action: "input->checkout#formatPhone" }, class: "w-full text-sm font-mono font-bold p-2.5 rounded-xl border border-neutral-300 bg-white focus:ring-2 focus:ring-[#00A859] focus:outline-none" %>
            </div>
            <div data-checkout-target="phoneStatus" class="text-[10px]">
              <span class="text-neutral-400">e.g. 0707 172 370</span>
            </div>
          </div>

          <div class="pt-2">
            <%= f.button type: :submit, class: "w-full py-3.5 px-5 rounded-xl bg-[#00A859] hover:bg-[#008F4C] text-white font-bold text-sm flex items-center justify-center space-x-2 shadow hover:shadow-md transition-all cursor-pointer" do %>
              <span data-checkout-target="submitBtnText">Complete Order • <%= CurrencyHelper.format_money(@total_kes, "KES") %></span>
            <% end %>
          </div>
        </div>

      </div>

      <!-- Right Column: Order Summary -->
      <div class="lg:col-span-5 space-y-4">
        <div class="bg-white p-5 sm:p-6 rounded-2xl border border-[#EFE7DA] shadow-xs space-y-4 sticky top-24">
          <div class="flex items-center justify-between border-b border-[#EFE7DA] pb-3">
            <h3 class="font-serif text-base font-bold text-[#140B07]">Order Summary</h3>
            <span class="text-xs font-medium text-neutral-500"><%= @cart_items.sum { |i| i[:quantity] } %> items</span>
          </div>

          <!-- Items List -->
          <div class="divide-y divide-[#FAF6EE] max-h-56 overflow-y-auto space-y-1">
            <% @cart_items.each do |item| %>
              <div class="py-2.5 flex items-center justify-between gap-3 text-xs">
                <div class="w-10 h-10 rounded-lg overflow-hidden bg-[#FAF6EE] border border-[#EFE7DA] shrink-0">
                  <img src="<%= item[:product].display_image_url %>" alt="<%= item[:product].name %>" class="w-full h-full object-cover">
                </div>
                <div class="flex-1 min-w-0">
                  <span class="font-medium text-[#140B07] block truncate"><%= item[:product].name %></span>
                  <span class="text-[10px] text-neutral-400">Qty: <%= item[:quantity] %><% if item[:format].present? %> • <%= item[:format] %><% end %></span>
                </div>
                <span class="font-bold text-[#9E472A] whitespace-nowrap">
                  <%= CurrencyHelper.format_money(current_currency == 'ETB' ? item[:total_etb] : item[:total_kes], current_currency) %>
                </span>
              </div>
            <% end %>
          </div>

          <!-- Totals Breakdown -->
          <div class="space-y-2 pt-3 border-t border-[#EFE7DA] text-xs">
            <div class="flex justify-between text-neutral-600">
              <span>Subtotal</span>
              <span class="font-semibold text-[#140B07]"><%= CurrencyHelper.format_money(@subtotal_kes, "KES") %></span>
            </div>

            <div class="flex justify-between text-neutral-600">
              <span>Logistics</span>
              <span data-checkout-target="shippingDisplay" class="font-semibold text-[#140B07]">
                <%= CurrencyHelper.format_money(@shipping_quote[:shipping_fee_kes], "KES") %>
              </span>
            </div>

            <div class="pt-2 border-t border-[#EFE7DA] flex justify-between items-baseline">
              <span class="font-bold text-[#140B07]">Total Due</span>
              <span data-checkout-target="totalDisplay" class="font-serif text-xl font-bold text-[#9E472A]">
                <%= CurrencyHelper.format_money(@total_kes, "KES") %>
              </span>
            </div>

            <div class="text-right text-[10px] text-neutral-400">
              ≈ <span data-checkout-target="totalDisplayEtb"><%= CurrencyHelper.format_money(@total_etb, "ETB") %></span>
            </div>
          </div>
        </div>
      </div>

    <% end %>

  </div>

  <!-- Processing Modal -->
  <div data-checkout-target="processingModal" class="fixed inset-0 bg-black/75 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 border border-[#EFE7DA] shadow-lg text-center space-y-4">
      <div class="space-y-1">
        <h3 class="font-serif text-lg font-bold text-[#140B07]">Processing Order</h3>
        <p class="text-xs text-neutral-600">
          Authorization dispatched to:
        </p>
        <div data-checkout-target="modalPhone" class="text-sm font-mono font-bold text-[#00A859]">
          <%= @default_phone %>
        </div>
      </div>

      <div class="p-3 rounded-xl bg-[#FAF6EE] border border-[#EFE7DA] text-xs space-y-1 text-center">
        <div class="text-neutral-500">Amount:</div>
        <div class="font-bold text-[#140B07]" data-checkout-target="modalAmount"><%= CurrencyHelper.format_money(@total_kes, "KES") %></div>
      </div>

      <div class="text-xs text-neutral-500 font-medium">
        Connecting to gateway...
      </div>
    </div>
  </div>

</div>

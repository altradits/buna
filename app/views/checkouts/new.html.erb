<div class="py-12 bg-[#FAF6EE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    
    <div class="border-b border-[#EFE7DA] pb-6">
      <span class="text-xs font-bold text-[#9E472A] uppercase tracking-widest">Direct Kenyan Delivery</span>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-[#140B07]">Ceremony Checkout</h1>
      <p class="text-xs text-neutral-600 mt-1">Cross-border freight from Addis Ababa Bole Hub to your Kenyan doorstep via Safaricom M-Pesa.</p>
    </div>

    <%= form_with url: checkout_path, method: :post, local: true, class: "grid grid-cols-1 lg:grid-cols-12 gap-12 items-start" do |f| %>
      
      <!-- Left Column: Shipping & Customer Details -->
      <div class="lg:col-span-7 space-y-8">
        
        <!-- Recipient Information -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#EFE7DA] shadow-sm space-y-4">
          <div class="flex items-center space-x-3 border-b border-[#EFE7DA] pb-4">
            <div class="w-8 h-8 rounded-lg bg-[#24130D] text-[#E5A652] flex items-center justify-center font-bold text-xs">1</div>
            <h2 class="font-serif text-lg font-bold text-[#140B07]">Customer & Recipient Details</h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-1">Full Name</label>
              <%= f.text_field :customer_name, value: (current_user&.full_name || "Buna Connoisseur"), required: true, class: "w-full text-xs p-3 rounded-xl border border-[#EFE7DA] bg-[#FAF6EE]/50 focus:ring-2 focus:ring-[#D48B38] focus:bg-white focus:outline-none" %>
            </div>

            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-1">Email Address (Order Confirmation)</label>
              <%= f.email_field :customer_email, value: (current_user&.email || "yebente@gmail.com"), required: true, class: "w-full text-xs p-3 rounded-xl border border-[#EFE7DA] bg-[#FAF6EE]/50 focus:ring-2 focus:ring-[#D48B38] focus:bg-white focus:outline-none" %>
            </div>
          </div>
        </div>

        <!-- Kenyan Delivery Location -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#EFE7DA] shadow-sm space-y-4">
          <div class="flex items-center space-x-3 border-b border-[#EFE7DA] pb-4">
            <div class="w-8 h-8 rounded-lg bg-[#24130D] text-[#E5A652] flex items-center justify-center font-bold text-xs">2</div>
            <h2 class="font-serif text-lg font-bold text-[#140B07]">Kenyan Shipping Destination</h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-1">Destination County (Kenya)</label>
              <%= f.select :delivery_county, options_for_select(@counties, @selected_county), {}, class: "w-full text-xs p-3 rounded-xl border border-[#EFE7DA] bg-white focus:ring-2 focus:ring-[#D48B38] focus:outline-none" %>
            </div>

            <div>
              <label class="block text-xs font-semibold text-neutral-700 mb-1">City / Neighborhood</label>
              <%= f.text_field :delivery_city, value: "Nairobi (Westlands / Kilimani / Karen)", required: true, class: "w-full text-xs p-3 rounded-xl border border-[#EFE7DA] bg-[#FAF6EE]/50 focus:ring-2 focus:ring-[#D48B38] focus:bg-white focus:outline-none" %>
            </div>

            <div class="sm:col-span-2">
              <label class="block text-xs font-semibold text-neutral-700 mb-1">Street Address, Apartment or Building</label>
              <%= f.text_area :delivery_address, rows: 2, placeholder: "e.g. House 14, Acacia Avenue, Lavington, Nairobi", required: true, class: "w-full text-xs p-3 rounded-xl border border-[#EFE7DA] bg-[#FAF6EE]/50 focus:ring-2 focus:ring-[#D48B38] focus:bg-white focus:outline-none" %>
            </div>
          </div>

          <!-- Courier Selection -->
          <div class="pt-4 border-t border-[#EFE7DA]">
            <label class="block text-xs font-semibold text-neutral-700 mb-2">Select Regional Courier Partner</label>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <label class="p-3 rounded-xl border border-[#D48B38] bg-[#FAF6EE] flex items-center space-x-2 cursor-pointer text-xs">
                <%= f.radio_button :courier_provider, "Fargo Courier East Africa", checked: true, class: "text-[#D48B38]" %>
                <span><strong>Fargo Courier</strong> (Moyale Corridor)</span>
              </label>
              <label class="p-3 rounded-xl border border-[#EFE7DA] bg-white flex items-center space-x-2 cursor-pointer text-xs">
                <%= f.radio_button :courier_provider, "Sendy Express Kenya", class: "text-[#D48B38]" %>
                <span><strong>Sendy Express</strong> (Direct Doorstep)</span>
              </label>
              <label class="p-3 rounded-xl border border-[#EFE7DA] bg-white flex items-center space-x-2 cursor-pointer text-xs">
                <%= f.radio_button :courier_provider, "DHL East Africa", class: "text-[#D48B38]" %>
                <span><strong>DHL East Africa</strong> (Priority Flight)</span>
              </label>
            </div>
          </div>
        </div>

        <!-- M-Pesa Payment Details -->
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#EFE7DA] shadow-sm space-y-4">
          <div class="flex items-center space-x-3 border-b border-[#EFE7DA] pb-4">
            <div class="w-8 h-8 rounded-lg bg-[#00A859] text-white flex items-center justify-center font-bold text-xs">3</div>
            <div>
              <h2 class="font-serif text-lg font-bold text-[#140B07]">Safaricom M-Pesa Express Checkout</h2>
              <p class="text-[11px] text-neutral-500">Pay directly with your Safaricom mobile money balance.</p>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-[#00A859]/5 border border-[#00A859]/20 space-y-3">
            <div class="flex items-center space-x-2 text-xs font-bold text-[#00A859]">
              <span class="w-2 h-2 rounded-full bg-[#00A859] animate-pulse"></span>
              <span>M-Pesa STK Push Prompt</span>
            </div>
            
            <div>
              <label class="block text-xs font-semibold text-neutral-800 mb-1">
                Enter Your Safaricom Phone Number
              </label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-xs font-bold text-neutral-500">🇰🇪</span>
                <%= f.telephone_field :customer_phone, value: @default_phone, placeholder: "0707172370 or 254707172370", required: true, class: "w-full pl-10 text-sm font-semibold p-3.5 rounded-xl border border-neutral-300 bg-white focus:ring-2 focus:ring-[#00A859] focus:outline-none" %>
              </div>
              <p class="text-[11px] text-neutral-500 mt-1">An instant pop-up will appear on this phone asking for your M-Pesa PIN.</p>
            </div>
          </div>

          <div class="pt-2">
            <%= f.button type: :submit, class: "w-full py-4 px-6 rounded-2xl bg-[#00A859] hover:bg-[#008F4C] text-white font-bold text-base flex items-center justify-center space-x-3 shadow-lg hover:shadow-xl transition-all cursor-pointer" do %>
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-6h2v6zm4 0h-2v-6h2v6zm-2-8c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"/></svg>
              <span>Authorize M-Pesa Payment • <%= CurrencyHelper.format_money(@total_kes, "KES") %></span>
            <% end %>
          </div>
        </div>

      </div>

      <!-- Right Column: Order Summary -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-white p-6 sm:p-8 rounded-3xl border border-[#EFE7DA] shadow-sm space-y-6 sticky top-28">
          <h3 class="font-serif text-xl font-bold text-[#140B07] border-b border-[#EFE7DA] pb-4">Consignment Summary</h3>

          <div class="divide-y divide-[#EFE7DA] max-h-72 overflow-y-auto pr-1">
            <% @cart_items.each do |item| %>
              <div class="py-3 flex justify-between items-start text-xs">
                <div>
                  <h4 class="font-bold text-[#140B07]"><%= item[:product].name %></h4>
                  <p class="text-[11px] text-neutral-500">
                    <%= item[:format] %> • Qty: <%= item[:quantity] %>
                  </p>
                </div>
                <div class="font-bold text-[#9E472A]">
                  <%= item[:product].formatted_price(current_currency) %>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Totals Breakdown -->
          <div class="space-y-2 pt-4 border-t border-[#EFE7DA] text-xs">
            <div class="flex justify-between text-neutral-600">
              <span>Merchandise Subtotal</span>
              <span class="font-semibold text-[#140B07]"><%= CurrencyHelper.format_money(@cart_items.sum { |i| i[:total_kes] }, "KES") %></span>
            </div>

            <div class="flex justify-between text-neutral-600">
              <span>East African Cross-Border Logistics</span>
              <span class="font-semibold text-[#140B07]"><%= CurrencyHelper.format_money(@shipping_quote[:shipping_fee_kes], "KES") %></span>
            </div>

            <div class="flex justify-between text-neutral-500 text-[11px]">
              <span>Moyale OSBP Customs & Handling</span>
              <span class="text-[#00A859] font-medium">Included</span>
            </div>

            <div class="pt-4 border-t border-[#EFE7DA] flex justify-between items-baseline">
              <span class="font-serif text-base font-bold text-[#140B07]">Total Due (KES)</span>
              <span class="font-serif text-2xl font-bold text-[#9E472A]">
                <%= CurrencyHelper.format_money(@total_kes, "KES") %>
              </span>
            </div>

            <div class="text-right text-[11px] text-neutral-500">
              Equivalent: <strong><%= CurrencyHelper.format_money(@total_etb, "ETB") %></strong>
            </div>
          </div>

          <!-- Merchant Confidence Badge -->
          <div class="p-4 rounded-2xl bg-[#FAF6EE] border border-[#EFE7DA] text-[11px] text-neutral-600 space-y-1">
            <div class="font-bold text-[#24130D]">Yebente Buna Guarantee</div>
            <p>Direct authentic Ethiopian sourcing. Freshly roasted in Addis Ababa, sealed for aroma retention, and dispatched across the Kenya-Ethiopia corridor.</p>
          </div>
        </div>
      </div>

    <% end %>

  </div>
</div>

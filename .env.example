# ==============================================================================
# YEBENTE BUNA - ENVIRONMENT CONFIGURATION (PRODUCTION & DEVELOPMENT)
# Premium Ethiopian Coffee, Artifacts & Cultural Ware for the Kenyan Market
# ==============================================================================

# Application Branding & Core Identifiers
APP_NAME="Yebente Buna"
APP_AMHARIC_NAME="የበንቴ ቡና"
APP_TAGLINE="Authentic Ethiopian Coffee & Cultural Ceremony Direct to Kenya"
APP_HOST="yebente.africa"
APP_URL="https://yebente.africa"
PORT=3000
RAILS_ENV=development

# Operational Merchant & Administrator Contact (Per Specifications)
DEFAULT_MERCHANT_PHONE="+254707172370"
ADMIN_EMAIL="yebente@gmail.com"
SUPPORT_PHONE="+254707172370"

# Regional Localization & Multi-Currency Engine
APPLICATION_TIMEZONE="Africa/Nairobi"
BASE_CURRENCY="KES"
SECONDARY_CURRENCY="ETB"
# KES to ETB dynamic conversion rate (1 KES = approx 0.88 ETB or configured peg)
KES_TO_ETB_RATE="0.88"
ETB_TO_KES_RATE="1.136"

# Safaricom M-Pesa Daraja API Integration (Kenya Checkout)
MPESA_ENVIRONMENT="sandbox" # sandbox or production
MPESA_CONSUMER_KEY="YOUR_MPESA_CONSUMER_KEY"
MPESA_CONSUMER_SECRET="YOUR_MPESA_CONSUMER_SECRET"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_B2C_SHORTCODE="600000"
MPESA_INITIATOR_NAME="testapi"
MPESA_INITIATOR_PASSWORD="YOUR_INITIATOR_PASSWORD"
MPESA_CALLBACK_URL="https://yebente.africa/api/v1/mpesa/callback"
MPESA_C2B_VALIDATION_URL="https://yebente.africa/api/v1/mpesa/c2b_validation"
MPESA_C2B_CONFIRMATION_URL="https://yebente.africa/api/v1/mpesa/c2b_confirmation"

# East African Courier Logistics APIs (Cross-Border Ethiopia -> Kenya)
ETHIO_LOGISTICS_HUB="Addis Ababa Bole Central Fulfillment Hub"
KENYA_DISTRIBUTION_HUB="Nairobi Industrial Area Logistics Center"
MOYALE_BORDER_STATION="Moyale One-Stop Border Post (OSBP) Customs Cleared"
COURIER_DEFAULT_PROVIDER="Fargo Courier East Africa"
FARGO_COURIER_API_KEY="sandbox_fargo_key"
SENDY_COURIER_API_KEY="sandbox_sendy_key"
DHL_EAST_AFRICA_API_KEY="sandbox_dhl_ea_key"

# Database Configuration (PostgreSQL)

# ==============================================================================
# YEBENTE BUNA - PRODUCTION NGINX CONFIGURATION TEMPLATE
# For Standard VPS / Dedicated Linux Hosting with Custom Domain & SSL (Certbot)
# Replace 'yourdomain.com' with your registered domain (e.g. yebente.africa / yebentebuna.co.ke)
# ==============================================================================

upstream puma_yebente {
  server 127.0.0.1:3000 fail_timeout=0;
  # Or unix socket: server unix:/var/www/yebente/shared/tmp/sockets/puma.sock fail_timeout=0;
}

# Redirect HTTP to HTTPS
server {
  listen 80;
  listen [::]:80;
  server_name yourdomain.com www.yourdomain.com;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# HTTPS Server Block
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name yourdomain.com www.yourdomain.com;

  root /var/www/yebente/current/public;
  access_log /var/log/nginx/yebente_access.log;
  error_log /var/log/nginx/yebente_error.log info;

  # SSL Certificates (managed via Certbot: certbot --nginx -d yourdomain.com)
  ssl_certificate /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers HIGH:!aNULL:!MD5;
  ssl_prefer_server_ciphers on;

  # Security Headers
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-XSS-Protection "1; mode=block" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # Static Assets Caching
  location ^~ /assets/ {
    gzip_static on;
    expires max;
    add_header Cache-Control public;
    try_files $uri =404;
  }

  location ^~ /packs/ {
    gzip_static on;
    expires max;
    add_header Cache-Control public;
    try_files $uri =404;
  }

  # Safaricom M-Pesa IPN Webhook & General Rails Application Proxy
  location / {
    proxy_pass http://puma_yebente;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Ssl on;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_redirect off;

    # Timeouts for background jobs and M-Pesa STK polling
    proxy_read_timeout 60s;
    proxy_connect_timeout 60s;
  }

  # Custom error pages
  error_page 500 502 503 504 /500.html;
  client_max_body_size 20M;
  keepalive_timeout 10;
}
